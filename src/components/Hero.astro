---
// 21st.dev-sourced interactive background, replacing the earlier static
// poster-frame placeholder. Colors recolored from the component's default
// neon cyan to Coherenz's own palette (DESIGN.md §1) — orange nodes, yellow
// pulses, matching the eyebrow/CTA accent already used in this section.
import { base } from '../lib/base';
import InteractiveSynapseNetwork from './ui/interactive-synapse-network';
---

<section class="relative flex min-h-screen items-center overflow-hidden bg-navy">
  <div class="absolute inset-0">
    <InteractiveSynapseNetwork
      client:load
      nodeColor="rgba(232,160,48,0.75)"
      pulseColor="rgba(240,192,64,1)"
      nodeCount={45}
      connectionRadius={180}
      trailOpacity={0.18}
      ariaLabel="Decorative animated network background"
    />
  </div>
  <div class="absolute inset-0 bg-gradient-to-b from-navy/30 via-transparent to-navy/70" />

  <img src={`${base}img/monogram-full.png`} alt="" class="pointer-events-none absolute -right-24 top-1/2 w-[520px] -translate-y-1/2 opacity-10" />

  <div class="relative mx-auto w-full max-w-[1180px] px-6 py-32">
    <div class="max-w-2xl">
      <p class="text-sm font-bold uppercase tracking-[0.375em] text-yellow">Product Delivery Economics™</p>
      <h1 class="mt-4 font-serif text-5xl leading-tight text-white sm:text-6xl">
        <span class="whitespace-nowrap">Delivery is an investment.</span><br />Treat it like one.
      </h1>
      <p class="mt-4 max-w-xl text-base text-white/80">
        Coherenz helps product organizations make better investment, prioritization and delivery
        decisions—turning delivery capacity into measurable business value.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href={`${base}approach`} class="rounded-full bg-primary px-6 py-3 text-sm font-bold text-primary-foreground">
          Explore our approach →
        </a>
        <a href={`${base}contact`} class="rounded-full border-2 border-white px-6 py-3 text-sm font-bold text-white">
          Talk to Coherenz
        </a>
      </div>
    </div>
  </div>
</section>
