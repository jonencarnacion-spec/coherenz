---
// 21st.dev-sourced interactive background — orbital solar-system animation.
// Base fill and scrim veil were both hardcoded to pure black in the source;
// replaced with a flat ~15%-darkened Coherenz navy (#1A2744 → #16213A, see
// orbital-hero-section.tsx) so it keeps the brand's navy tone instead of
// black. focus/scrim push the Sun/orbits right and darken the left,
// matching where our real copy sits.
import { base } from '../lib/base';
import OrbitalHeroSection from './ui/orbital-hero-section';
---

<section class="sticky top-0 z-0 min-h-screen bg-navy">
  <div class="relative flex h-full min-h-screen items-center overflow-hidden">
    <div class="absolute inset-0">
      <OrbitalHeroSection
        client:load
        focus={[0.72, 0.45]}
        scrim="left"
        scrimStrength={0.85}
        hiddenBehind="#hero-duplicate"
      />
    </div>

    <div class="relative mx-auto w-full max-w-[1180px] px-6 py-32">
      <div class="hero-float-left max-w-2xl">
        <p class="text-sm font-bold uppercase tracking-[0.375em] text-yellow">Product Delivery Economics™</p>
        <h1 class="mt-4 font-serif text-5xl leading-tight text-white sm:text-6xl">
          <span class="whitespace-nowrap">Delivery is an investment.</span><br />Treat it like one.
        </h1>
        <p class="mt-4 max-w-xl text-base text-white/80">
          Coherenz helps product organizations make better investment, prioritization and delivery
          decisions—turning delivery capacity into measurable business value.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href={`${base}approach`} class="rounded-full bg-primary px-6 py-3 text-sm font-bold text-primary-foreground">
            Explore our approach →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Float-in from the left, same character as insights.astro's hero:
     28px travel, 1500ms, strong ease-out. Fires immediately since this
     hero is always in the first viewport on load. */
  .hero-float-left {
    opacity: 0;
    transform: translateX(-28px);
    transition:
      opacity 1500ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 1500ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .hero-float-left.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-float-left {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initHeroFloatLeft() {
    document.querySelectorAll<HTMLElement>('.hero-float-left').forEach((el) => {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          el.classList.add('is-visible');
          io.disconnect();
        },
        { threshold: 0.2 }
      );
      io.observe(el);
    });
  }

  initHeroFloatLeft();
  document.addEventListener('astro:page-load', initHeroFloatLeft);
</script>
