---
// 21st.dev-sourced interactive background — orbital solar-system animation.
// Base fill and scrim veil were both hardcoded to pure black in the source;
// replaced with a flat ~15%-darkened Coherenz navy (#1A2744 → #16213A, see
// orbital-hero-section.tsx) so it keeps the brand's navy tone instead of
// black. focus/scrim push the Sun/orbits right and darken the left,
// matching where our real copy sits.
import { base } from '../lib/base';
import OrbitalHeroSection from './ui/orbital-hero-section';
import { BlurReveal } from './ui/blur-reveal.tsx';
---

{/* min-h-[100dvh], not min-h-screen (100vh) -- on real mobile browsers,
    100vh includes space behind the address bar, which resizes as it
    shows/hides during scroll. That mismatch desyncs this section's sticky
    pin from the actual visible viewport (a real-device bug desktop mobile
    emulation doesn't reproduce, since emulation uses a fixed viewport
    height). dvh tracks the real, currently-visible viewport instead. */}
<section class="sticky top-0 z-0 min-h-[100dvh] bg-navy">
  <div class="relative flex h-full min-h-[100dvh] items-center overflow-hidden">
    <div class="absolute inset-0">
      <OrbitalHeroSection
        client:load
        focus={[0.72, 0.45]}
        scrim="left"
        scrimStrength={0.85}
        hiddenBehind="#hero-duplicate"
      />
    </div>

    <div class="relative mx-auto w-full max-w-[1180px] px-6 py-32">
      <div class="max-w-2xl">
        <BlurReveal client:visible delay={0} className="block">
          <p class="text-sm font-bold uppercase tracking-[0.375em] text-yellow">Product Delivery Economics™</p>
        </BlurReveal>
        <BlurReveal client:visible delay={0.1} className="block">
          <h1 class="mt-4 font-serif text-5xl leading-tight text-white sm:text-6xl">
            Delivery is an investment.<br />Treat it like one.
          </h1>
        </BlurReveal>
        <BlurReveal client:visible delay={0.2} className="block">
          <p class="mt-4 max-w-xl text-base text-white/80">
            Coherenz helps product organizations make better investment, prioritization and delivery
            decisions—turning delivery capacity into measurable business value.
          </p>
        </BlurReveal>
        <BlurReveal client:visible delay={0.3} className="block">
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href={`${base}approach`} class="rounded-full bg-primary px-6 py-3 text-sm font-bold text-primary-foreground">
              Explore our approach →
            </a>
          </div>
        </BlurReveal>
      </div>
    </div>
  </div>
</section>
