---
import { IconTarget, IconRoute, IconCircleCheck } from '@tabler/icons-react';

import { base } from '../lib/base';
const lenses = [
  { letters: 'WHAT', sub: 'Value Economics', q: 'Are we investing in the right things?', Icon: IconTarget, accent: 'border-t-green' },
  { letters: 'HOW', sub: 'Delivery Economics', q: 'Are we getting enough value from our delivery capacity?', Icon: IconRoute, accent: 'border-t-navy' },
  { letters: 'DID', sub: 'Outcome Economics', q: 'Did the investment create value?', Icon: IconCircleCheck, accent: 'border-t-green' },
];
---

<section id="lenses" class="bg-cream py-16 sm:py-24">
  <div class="mx-auto max-w-[1180px] px-6">
    <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">The Three Economic Lenses</p>
    <h2 class="mt-3 font-serif text-4xl text-navy sm:text-5xl">Three questions. One economic system.</h2>
    <p class="mt-3">
      <a href={`${base}approach`} class="font-bold text-orange">See the full approach →</a>
    </p>

    <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-3">
      {lenses.map(({ letters, sub, q, Icon, accent }) => (
        <div class={`rounded-[10px] border-t-4 bg-white p-6 shadow-sm ${accent}`}>
          <div class="flex h-9 w-9 items-center justify-center rounded-full border border-line text-navy">
            <Icon size={18} />
          </div>
          <p class="mt-3 text-xl font-bold text-green">{letters}</p>
          <p class="mt-1 text-xs font-bold uppercase tracking-wide text-muted-foreground">{sub}</p>
          <p class="mt-3 text-sm font-bold text-navy">{q}</p>
        </div>
      ))}
    </div>
  </div>
</section>
