---
// Rebuilt from Jon's mockup: the 5-stage Opportunity->Outcome stepper.
// The WHAT/HOW/DID lens cards are removed for the meantime — Jon's
// pyramid.svg is meant to go in their place, pending layout.
// The mockup's bottom navy banner (See the Gaps/Focus/Improve/Drive) was
// dropped per earlier request — that pattern already exists on this page in
// the Gap Diagram section, so repeating it here read as redundant.
// - Stage 05 (Outcome) is purple in the mockup, but DESIGN.md's locked
//   palette has no purple token. Reused the red already established for
//   "Outcome" in GapDiagram.tsx instead of introducing a new color.
// - Stage 03 (Product) uses the deeper gold (#B08900) already established
//   for the Product stage in gapDiagram.ts, rather than the lighter
//   --yellow token, for cross-section consistency.
import pyramidSvgRaw from '../assets/pyramid2.svg?raw';
import {
  IconRadar,
  IconCoin,
  IconHammer,
  IconBolt,
  IconTrendingUp,
  IconArrowRight,
  IconCircleCheckFilled,
  IconTargetArrow,
  IconChartBar,
  IconSettingsAutomation,
  IconX,
} from '@tabler/icons-react';

import { base } from '../lib/base';

// The pyramid's 3 solid-color faces are inlined (rather than <img src>) so
// each face can get its own hover state. Wrapping targets the exact <path>
// markup for each face (found by matching its fill class + unique `d`) — no
// destination/click action wired up yet, per Jon's call to keep this as
// hover-only feedback for now.
let pyramidSvg = pyramidSvgRaw.replace(/^<\?xml[^>]*\?>\s*/, '');

const pyramidFaces: [string, string][] = [
  [
    '<path class="cls-14" d="M277.16,495.02H23.21c-17.53,0-24.64-12.3-15.87-27.48l126.98-219.86,142.84,82.43v164.91Z"/>',
    '01',
  ],
  [
    '<path class="cls-18" d="M286.68,313.61l-142.85-82.43L270.81,11.38c8.76-15.18,22.97-15.18,31.74,0l126.98,219.8-142.85,82.43Z"/>',
    '02',
  ],
  [
    '<path class="cls-29" d="M550.22,495.02h-254.02v-164.85l142.85-82.49,127.03,219.86c8.77,15.18,1.67,27.48-15.87,27.48Z"/>',
    '03',
  ],
];

for (const [facePath, num] of pyramidFaces) {
  pyramidSvg = pyramidSvg.replace(facePath, `<g class="pyramid-face" data-face="${num}">${facePath}</g>`);
}

pyramidSvg = pyramidSvg.replace(
  '</style>',
  `
      .pyramid-face { cursor: pointer; }
      .pyramid-face path { transition: filter .15s ease; }
      .pyramid-face:hover path { filter: grayscale(45%) brightness(0.92); }
    </style>`
);

// Bring back the two-tone divider line that sat across the center circle in
// the first pyramid export (removed earlier along with the circle itself).
// Same coordinates/colors as the original pyramid.svg — split red/teal bar.
pyramidSvg = pyramidSvg.replace(
  '<path class="cls-29" d="M183.73,324.63c0-54.87,44.5-99.34,99.39-99.34s99.39,44.47,99.39,99.34-44.5,99.34-99.39,99.34-99.39-44.48-99.39-99.34Z"/>',
  `<path class="cls-29" d="M183.73,324.63c0-54.87,44.5-99.34,99.39-99.34s99.39,44.47,99.39,99.34-44.5,99.34-99.39,99.34-99.39-44.48-99.39-99.34Z"/>
      <g>
        <rect fill="#ef4038" x="216.09" y="344.14" width="66.73" height="3.08"/>
        <rect fill="#0c495b" x="282.81" y="344.14" width="66.73" height="3.08"/>
      </g>`
);

const stages = [
  {
    num: '01',
    name: 'Opportunity',
    sub: 'WHAT could create value?',
    desc: 'Identify customer needs, market gaps, problems, risks and possibilities.',
    Icon: IconRadar,
    color: '#1A2744',
  },
  {
    num: '02',
    name: 'Investment',
    sub: 'WHAT should we fund?',
    desc: 'Allocate scarce resources to the opportunities with the strongest economic potential.',
    Icon: IconCoin,
    color: '#E8A030',
  },
  {
    num: '03',
    name: 'Product',
    sub: 'WHAT should we build?',
    desc: 'Translate investment decisions into products, capabilities and features that address the need.',
    Icon: IconHammer,
    color: '#B08900',
  },
  {
    num: '04',
    name: 'Delivery',
    sub: 'HOW efficiently can we deliver?',
    desc: 'Manage flow, capacity, quality, and coordination to deliver value consistently.',
    Icon: IconBolt,
    color: '#2E5077',
  },
  {
    num: '05',
    name: 'Outcome',
    sub: 'DID we create value?',
    desc: 'Measure the impact on customers, the business, and the organization.',
    Icon: IconTrendingUp,
    color: '#D14A3E',
  },
];
---

<section id="lenses" class="relative overflow-hidden bg-wash-green py-10 sm:py-12">
  <div class="-mt-10 mb-4 flex h-12 items-center bg-green sm:-mt-12 sm:mb-5">
    <div class="mx-auto w-full max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <p class="text-base font-bold text-white">HOW WE OPERATE</p>
    </div>
  </div>

  <div id="lens-content" class="relative isolate mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
    <div class="text-center">
      <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">Coherenz Economic Lense</p>
      <h2 class="mt-3 font-serif text-4xl text-navy sm:text-5xl">
        Three questions. One economic system.
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-foreground/70">
        Every delivery decision is an economic decision. We use three lenses to align what we invest
        in, how we deliver it, and the value we create.
      </p>
      <p class="mt-3">
        <a href={`${base}approach`} class="font-bold text-orange">See the full approach →</a>
      </p>
    </div>

    <div id="pyramid-wrap" class="relative z-10 mx-auto mt-4 w-full max-w-[440px] [&>svg]:h-auto [&>svg]:w-full">
      <Fragment set:html={pyramidSvg} />
      <p class="pointer-events-none absolute left-[46.43%] top-[60.4%] w-[30%] -translate-x-1/2 -translate-y-full pb-1 text-center text-[13px] font-bold uppercase leading-tight tracking-wide text-navy">
        The Three<br />Economic Lenses
      </p>
      <div id="what-label" class="pointer-events-none absolute left-[17%] top-[75.5%] w-[26%] translate-x-[calc(-50%+4px)] -translate-y-1/2 text-right text-white">
        <p class="text-[30px] font-extrabold uppercase leading-none">What</p>
        <p class="mt-1 text-[10px] font-medium leading-tight">Value Economics</p>
      </div>
      <div class="pointer-events-none absolute left-[47%] top-[23.9%] w-[34%] -translate-x-1/2 -translate-y-1/2 text-center text-white">
        <p class="text-[30px] font-extrabold uppercase leading-none">How</p>
        <p class="mt-1 text-[10px] font-medium leading-tight">Delivery Economics</p>
      </div>
      <div class="pointer-events-none absolute left-[83%] top-[75.5%] w-[24%] translate-x-[calc(-50%-20px)] -translate-y-1/2 text-left text-navy">
        <p class="text-[30px] font-extrabold uppercase leading-none">Did</p>
        <p class="mt-1 text-[10px] font-medium leading-tight">Outcome Economics</p>
      </div>
    </div>

    <svg
      id="what-lens-connector"
      class="pointer-events-none absolute inset-0 z-0 h-full w-full opacity-0 transition-opacity duration-200"
      style="overflow: visible;"
    >
      <line id="what-lens-line" x1="0" y1="0" x2="0" y2="0" stroke="#8FADCC" stroke-width="0.5" stroke-dasharray="4 4" />
    </svg>

    <svg
      id="did-lens-connector"
      class="pointer-events-none absolute inset-0 z-0 h-full w-full opacity-0 transition-opacity duration-200"
      style="overflow: visible;"
    >
      <line id="did-lens-line" x1="0" y1="0" x2="0" y2="0" stroke="#8FC7B0" stroke-width="0.5" stroke-dasharray="4 4" />
    </svg>

    <svg
      id="how-lens-connector"
      class="pointer-events-none absolute inset-0 z-0 h-full w-full opacity-0 transition-opacity duration-200"
      style="overflow: visible;"
    >
      <line id="how-lens-line" x1="0" y1="0" x2="0" y2="0" stroke="#E8C596" stroke-width="0.5" stroke-dasharray="4 4" />
    </svg>

    <div
      id="what-lens-card"
      class="pointer-events-none absolute z-20 w-[420px] scale-95 rounded-2xl border border-white/50 bg-white/70 p-5 opacity-0 shadow-xl backdrop-blur-lg transition-all duration-200 ease-out"
    >
      <button
        type="button"
        id="what-lens-close"
        aria-label="Close"
        class="absolute right-3 top-3 text-navy/40 hover:text-navy/70"
      >
        <IconX size={16} />
      </button>
      <div class="text-left">
        <div class="flex items-center gap-3">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-orange text-white">
            <IconTargetArrow size={22} strokeWidth={1.8} />
          </div>
          <div>
            <p class="text-lg font-extrabold uppercase leading-none text-navy">What</p>
            <p class="mt-1 text-[11px] font-bold uppercase tracking-wide text-blue">Value Economics</p>
          </div>
        </div>
        <p class="mt-4 text-base font-bold text-navy">
          Are we <span class="text-blue">investing</span> in the <span class="text-blue">right things</span>?
        </p>
        <ul class="mt-3 space-y-2">
          {[
            'Identify and compare opportunities',
            'Quantify potential value',
            'Prioritize where value is highest',
          ].map((item) => (
            <li class="flex items-start gap-2 text-xs text-navy">
              <IconCircleCheckFilled size={16} class="mt-0.5 shrink-0 text-blue" />
              {item}
            </li>
          ))}
        </ul>
        <p class="mt-3 inline-block rounded-full bg-wash-blue px-3 py-1 text-[10px] font-bold uppercase tracking-wide text-blue">
          Covers: Opportunity → Investment
        </p>
      </div>
    </div>

    <div
      id="did-lens-card"
      class="pointer-events-none absolute z-20 w-[420px] scale-95 rounded-2xl border border-white/50 bg-white/70 p-5 opacity-0 shadow-xl backdrop-blur-lg transition-all duration-200 ease-out"
    >
      <button
        type="button"
        id="did-lens-close"
        aria-label="Close"
        class="absolute right-3 top-3 text-navy/40 hover:text-navy/70"
      >
        <IconX size={16} />
      </button>
      <div class="text-left">
        <div class="flex items-center gap-3">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-green text-white">
            <IconChartBar size={22} strokeWidth={1.8} />
          </div>
          <div>
            <p class="text-lg font-extrabold uppercase leading-none text-navy">Did</p>
            <p class="mt-1 text-[11px] font-bold uppercase tracking-wide text-green">Outcome Economics</p>
          </div>
        </div>
        <p class="mt-4 text-base font-bold text-navy">
          Did the investment <span class="text-green">create value</span>?
        </p>
        <ul class="mt-3 space-y-2">
          {[
            'Measure business and customer outcomes',
            'Link delivery to economic impact',
            'Learn and reinvest in what works',
          ].map((item) => (
            <li class="flex items-start gap-2 text-xs text-navy">
              <IconCircleCheckFilled size={16} class="mt-0.5 shrink-0 text-green" />
              {item}
            </li>
          ))}
        </ul>
        <p class="mt-3 inline-block rounded-full bg-wash-green px-3 py-1 text-[10px] font-bold uppercase tracking-wide text-green">
          Covers: Delivery → Outcome
        </p>
      </div>
    </div>

    <div
      id="how-lens-card"
      class="pointer-events-none absolute z-20 w-[420px] scale-95 rounded-2xl border border-white/50 bg-white/70 p-5 opacity-0 shadow-xl backdrop-blur-lg transition-all duration-200 ease-out"
    >
      <button
        type="button"
        id="how-lens-close"
        aria-label="Close"
        class="absolute right-3 top-3 text-navy/40 hover:text-navy/70"
      >
        <IconX size={16} />
      </button>
      <div class="text-left">
        <div class="flex items-center gap-3">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-navy text-white">
            <IconSettingsAutomation size={22} strokeWidth={1.8} />
          </div>
          <div>
            <p class="text-lg font-extrabold uppercase leading-none text-navy">How</p>
            <p class="mt-1 text-[11px] font-bold uppercase tracking-wide text-orange">Delivery Economics</p>
          </div>
        </div>
        <p class="mt-4 text-base font-bold text-navy">
          Are we getting <span class="text-orange">enough value</span> from our delivery capacity?
        </p>
        <ul class="mt-3 space-y-2">
          {[
            'Optimize flow, capacity, and throughput',
            'Reduce friction and coordination drag',
            'Align investment to delivery capability',
          ].map((item) => (
            <li class="flex items-start gap-2 text-xs text-navy">
              <IconCircleCheckFilled size={16} class="mt-0.5 shrink-0 text-orange" />
              {item}
            </li>
          ))}
        </ul>
        <p class="mt-3 inline-block rounded-full bg-orange/15 px-3 py-1 text-[10px] font-bold uppercase tracking-wide text-orange">
          Covers: Investment → Delivery
        </p>
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-8 sm:flex-row sm:items-start sm:gap-0">
      {stages.map((stage, i) => (
        <Fragment>
          <div class="flex flex-col items-center text-center sm:flex-1 sm:px-2">
            <div
              class="flex h-14 w-14 items-center justify-center rounded-full text-white"
              style={{ backgroundColor: stage.color }}
            >
              <stage.Icon size={24} strokeWidth={1.8} />
            </div>
            <p class="mt-3 text-sm font-extrabold uppercase tracking-wide text-navy">
              {stage.num} {stage.name}
            </p>
            <p class="mt-1 text-base font-semibold" style={{ color: stage.color }}>{stage.sub}</p>
            <p class="mt-2 text-xs leading-relaxed text-foreground/70">{stage.desc}</p>
          </div>
          {i < stages.length - 1 && (
            <div class="hidden items-center justify-center sm:flex sm:px-1 sm:pt-5">
              <IconArrowRight class="h-5 w-5 shrink-0 text-line" />
            </div>
          )}
        </Fragment>
      ))}
    </div>
  </div>
</section>

<script>
  interface LensCardConfig {
    triggerSelector: string;
    cardId: string;
    closeId: string;
    connectorId: string;
    lineId: string;
    side: 'left' | 'right';
    // Fixed anchor point for the connector line, as a fraction of the
    // pyramid box — pick one confirmed (via hit-testing) to sit on that
    // face's actual fill, since a triangle's bounding box has empty
    // corners a naive edge/center point can fall into.
    anchorX: number;
    anchorY: number;
    // Where the card's bottom edge lines up vertically, as a fraction of
    // the pyramid box's height from its top. Defaults to 1 (the pyramid's
    // own bottom) — HOW's trigger sits near the top, so its card uses a
    // smaller fraction to land closer to that face instead of the very
    // bottom of the pyramid.
    bottomAnchorFraction?: number;
    // How far to shift the card vertically from that anchor point, in
    // units of the card's own height. Negative = up, positive = down.
    // Defaults to -0.5 ("push up half its height").
    verticalShift?: number;
  }

  function initLensCard(config: LensCardConfig, registry: Array<() => void>) {
    const wrapper = document.getElementById('lens-content');
    const pyramidWrap = document.getElementById('pyramid-wrap');
    const trigger = document.querySelector(config.triggerSelector);
    const card = document.getElementById(config.cardId);
    const closeBtn = document.getElementById(config.closeId);
    const connector = document.getElementById(config.connectorId);
    const line = document.getElementById(config.lineId);
    if (!wrapper || !pyramidWrap || !trigger || !card || !closeBtn || !connector || !line) return;

    let open = false;
    const gap = 40;
    const margin = 4;
    const maxCardWidth = 420;
    const minCardWidth = 240;

    function position() {
      const wrapperRect = wrapper.getBoundingClientRect();
      const pyramidRect = pyramidWrap.getBoundingClientRect();

      // Shrink the card to fit the gap between the wrapper edge and the
      // pyramid, instead of letting a fixed width overlap the pyramid on
      // narrower viewports.
      const availableWidth =
        config.side === 'left'
          ? pyramidRect.left - wrapperRect.left - gap - margin
          : wrapperRect.right - pyramidRect.right - gap - margin;
      const cardWidth = Math.max(minCardWidth, Math.min(maxCardWidth, availableWidth));
      card.style.width = `${cardWidth}px`;

      const cardHeight = card.offsetHeight;
      const cardLeft =
        config.side === 'left'
          ? Math.max(margin, pyramidRect.left - wrapperRect.left - cardWidth - gap)
          : Math.min(
              wrapperRect.width - cardWidth - margin,
              pyramidRect.right - wrapperRect.left + gap
            );

      // Bottom of the card lines up with the configured point on the
      // pyramid, then shifted vertically by the configured amount.
      const bottomAnchor =
        pyramidRect.top + pyramidRect.height * (config.bottomAnchorFraction ?? 1);
      let cardTop =
        bottomAnchor - wrapperRect.top - cardHeight + cardHeight * (config.verticalShift ?? -0.5);
      const maxTop = wrapperRect.height - cardHeight - margin;
      cardTop = Math.max(margin, Math.min(cardTop, maxTop));

      card.style.left = `${cardLeft}px`;
      card.style.top = `${cardTop}px`;

      const x1 = pyramidRect.left - wrapperRect.left + pyramidRect.width * config.anchorX;
      const y1 = pyramidRect.top - wrapperRect.top + pyramidRect.height * config.anchorY;
      const x2 = config.side === 'left' ? cardLeft + cardWidth : cardLeft;
      const y2 = cardTop + cardHeight / 2;
      line.setAttribute('x1', String(x1));
      line.setAttribute('y1', String(y1));
      line.setAttribute('x2', String(x2));
      line.setAttribute('y2', String(y2));
    }

    function show() {
      for (const closeOther of registry) {
        if (closeOther !== hide) closeOther();
      }
      open = true;
      position();
      card.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
      card.classList.add('opacity-100', 'scale-100', 'pointer-events-auto');
      connector.classList.remove('opacity-0');
      connector.classList.add('opacity-100');
    }

    function hide() {
      open = false;
      card.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
      card.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
      connector.classList.add('opacity-0');
      connector.classList.remove('opacity-100');
    }

    trigger.addEventListener('click', () => (open ? hide() : show()));
    closeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      hide();
    });
    document.addEventListener('click', (e) => {
      if (!open) return;
      const target = e.target as Node;
      if (!card.contains(target) && !trigger.contains(target)) hide();
    });
    window.addEventListener('resize', () => {
      if (open) position();
    });

    registry.push(hide);
  }

  function initAllLensCards() {
    // Anchor points confirmed via hit-testing to sit on each face's fill —
    // between the "01"/"02"/"03" digit and the WHAT/HOW/DID text. Shared
    // registry so opening one card closes any other that's open.
    const registry: Array<() => void> = [];
    initLensCard(
      {
        triggerSelector: '.pyramid-face[data-face="01"]',
        cardId: 'what-lens-card',
        closeId: 'what-lens-close',
        connectorId: 'what-lens-connector',
        lineId: 'what-lens-line',
        side: 'left',
        anchorX: 0.14,
        anchorY: 0.6,
      },
      registry
    );
    initLensCard(
      {
        triggerSelector: '.pyramid-face[data-face="03"]',
        cardId: 'did-lens-card',
        closeId: 'did-lens-close',
        connectorId: 'did-lens-connector',
        lineId: 'did-lens-line',
        side: 'right',
        anchorX: 0.79,
        anchorY: 0.6,
      },
      registry
    );
    initLensCard(
      {
        triggerSelector: '.pyramid-face[data-face="02"]',
        cardId: 'how-lens-card',
        closeId: 'how-lens-close',
        connectorId: 'how-lens-connector',
        lineId: 'how-lens-line',
        side: 'right',
        anchorX: 0.4,
        anchorY: 0.3,
        bottomAnchorFraction: 0.55,
        verticalShift: 0,
      },
      registry
    );
  }

  initAllLensCards();
  document.addEventListener('astro:page-load', initAllLensCards);
</script>
