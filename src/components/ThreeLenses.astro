---
// Rebuilt from Jon's mockup: the 5-stage Opportunity->Outcome stepper.
// The WHAT/HOW/DID lens cards are removed for the meantime — Jon's
// pyramid.svg is meant to go in their place, pending layout.
// The mockup's bottom navy banner (See the Gaps/Focus/Improve/Drive) was
// dropped per earlier request — that pattern already exists on this page in
// the Gap Diagram section, so repeating it here read as redundant.
// - Stage 05 (Outcome) is purple in the mockup, but DESIGN.md's locked
//   palette has no purple token. Reused the red already established for
//   "Outcome" in GapDiagram.tsx instead of introducing a new color.
// - Stage 03 (Product) uses the deeper gold (#B08900) already established
//   for the Product stage in gapDiagram.ts, rather than the lighter
//   --yellow token, for cross-section consistency.
import pyramidSvgRaw from '../assets/pyramid2.svg?raw';
import {
  IconRadar,
  IconCoin,
  IconHammer,
  IconBolt,
  IconTrendingUp,
  IconArrowRight,
} from '@tabler/icons-react';

import { base } from '../lib/base';

// The pyramid's 3 solid-color faces are inlined (rather than <img src>) so
// each face can get its own hover state. Wrapping targets the exact <path>
// markup for each face (found by matching its fill class + unique `d`) — no
// destination/click action wired up yet, per Jon's call to keep this as
// hover-only feedback for now.
let pyramidSvg = pyramidSvgRaw.replace(/^<\?xml[^>]*\?>\s*/, '');

const pyramidFaces: [string, string][] = [
  [
    '<path class="cls-14" d="M277.16,495.02H23.21c-17.53,0-24.64-12.3-15.87-27.48l126.98-219.86,142.84,82.43v164.91Z"/>',
    '01',
  ],
  [
    '<path class="cls-18" d="M286.68,313.61l-142.85-82.43L270.81,11.38c8.76-15.18,22.97-15.18,31.74,0l126.98,219.8-142.85,82.43Z"/>',
    '02',
  ],
  [
    '<path class="cls-29" d="M550.22,495.02h-254.02v-164.85l142.85-82.49,127.03,219.86c8.77,15.18,1.67,27.48-15.87,27.48Z"/>',
    '03',
  ],
];

for (const [facePath, num] of pyramidFaces) {
  pyramidSvg = pyramidSvg.replace(facePath, `<g class="pyramid-face" data-face="${num}">${facePath}</g>`);
}

pyramidSvg = pyramidSvg.replace(
  '</style>',
  `
      .pyramid-face { cursor: pointer; }
      .pyramid-face path { transition: filter .15s ease; }
      .pyramid-face:hover path { filter: grayscale(45%) brightness(0.92); }
    </style>`
);

// Bring back the two-tone divider line that sat across the center circle in
// the first pyramid export (removed earlier along with the circle itself).
// Same coordinates/colors as the original pyramid.svg — split red/teal bar.
pyramidSvg = pyramidSvg.replace(
  '<path class="cls-29" d="M183.73,324.63c0-54.87,44.5-99.34,99.39-99.34s99.39,44.47,99.39,99.34-44.5,99.34-99.39,99.34-99.39-44.48-99.39-99.34Z"/>',
  `<path class="cls-29" d="M183.73,324.63c0-54.87,44.5-99.34,99.39-99.34s99.39,44.47,99.39,99.34-44.5,99.34-99.39,99.34-99.39-44.48-99.39-99.34Z"/>
      <g>
        <rect fill="#ef4038" x="216.09" y="344.14" width="66.73" height="3.08"/>
        <rect fill="#0c495b" x="282.81" y="344.14" width="66.73" height="3.08"/>
      </g>`
);

const stages = [
  {
    num: '01',
    name: 'Opportunity',
    sub: 'WHAT could create value?',
    desc: 'Identify customer needs, market gaps, problems, risks and possibilities.',
    Icon: IconRadar,
    color: '#1A2744',
  },
  {
    num: '02',
    name: 'Investment',
    sub: 'WHAT should we fund?',
    desc: 'Allocate scarce resources to the opportunities with the strongest economic potential.',
    Icon: IconCoin,
    color: '#E8A030',
  },
  {
    num: '03',
    name: 'Product',
    sub: 'WHAT should we build?',
    desc: 'Translate investment decisions into products, capabilities and features that address the need.',
    Icon: IconHammer,
    color: '#B08900',
  },
  {
    num: '04',
    name: 'Delivery',
    sub: 'HOW efficiently can we deliver?',
    desc: 'Manage flow, capacity, quality, and coordination to deliver value consistently.',
    Icon: IconBolt,
    color: '#174E40',
  },
  {
    num: '05',
    name: 'Outcome',
    sub: 'DID we create value?',
    desc: 'Measure the impact on customers, the business, and the organization.',
    Icon: IconTrendingUp,
    color: '#D14A3E',
  },
];
---

<section id="lenses" class="relative overflow-hidden bg-wash-green py-16 sm:py-24">
  <div class="-mt-16 mb-6 flex h-12 items-center bg-green sm:-mt-24 sm:mb-8">
    <div class="mx-auto w-full max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <p class="text-base font-bold text-white">Our Approach</p>
    </div>
  </div>

  <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
    <div class="text-center">
      <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">The Three Economic Lenses</p>
      <h2 class="mt-3 font-serif text-4xl text-navy sm:text-5xl">
        Three questions. One economic system.
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-foreground/70">
        Every delivery decision is an economic decision. We use three lenses to align what we invest
        in, how we deliver it, and the value we create.
      </p>
      <p class="mt-3">
        <a href={`${base}approach`} class="font-bold text-orange">See the full approach →</a>
      </p>
    </div>

    <div class="relative mx-auto mt-10 w-full max-w-[493px] [&>svg]:h-auto [&>svg]:w-full">
      <Fragment set:html={pyramidSvg} />
      <p class="pointer-events-none absolute left-[46.43%] top-[60.4%] w-[30%] -translate-x-1/2 -translate-y-full pb-1 text-center text-[13px] font-bold uppercase leading-tight tracking-wide text-navy">
        The Three<br />Economic Lenses
      </p>
      <div class="pointer-events-none absolute left-[17%] top-[75.5%] w-[26%] translate-x-[calc(-50%-8px)] -translate-y-1/2 text-right text-white">
        <p class="text-[30px] font-extrabold uppercase leading-none">What</p>
        <p class="mt-1 text-[10px] font-medium leading-tight">Value Economics</p>
      </div>
      <div class="pointer-events-none absolute left-[47%] top-[18%] w-[34%] -translate-x-1/2 -translate-y-1/2 text-center text-white">
        <p class="text-[30px] font-extrabold uppercase leading-none">How</p>
        <p class="mt-1 text-[10px] font-medium leading-tight">Delivery Economics</p>
      </div>
      <div class="pointer-events-none absolute left-[83%] top-[75.5%] w-[24%] translate-x-[calc(-50%-20px)] -translate-y-1/2 text-left text-navy">
        <p class="text-[30px] font-extrabold uppercase leading-none">Did</p>
        <p class="mt-1 text-[10px] font-medium leading-tight">Outcome Economics</p>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-8 sm:flex-row sm:items-start sm:gap-0">
      {stages.map((stage, i) => (
        <Fragment>
          <div class="flex flex-col items-center text-center sm:flex-1 sm:px-2">
            <div
              class="flex h-14 w-14 items-center justify-center rounded-full text-white"
              style={{ backgroundColor: stage.color }}
            >
              <stage.Icon size={24} strokeWidth={1.8} />
            </div>
            <p class="mt-3 text-sm font-extrabold uppercase tracking-wide text-navy">
              {stage.num} {stage.name}
            </p>
            <p class="mt-1 text-sm font-semibold" style={{ color: stage.color }}>{stage.sub}</p>
            <p class="mt-2 text-xs leading-relaxed text-foreground/70">{stage.desc}</p>
          </div>
          {i < stages.length - 1 && (
            <div class="hidden items-center justify-center sm:flex sm:px-1 sm:pt-5">
              <IconArrowRight class="h-5 w-5 shrink-0 text-line" />
            </div>
          )}
        </Fragment>
      ))}
    </div>
  </div>
</section>
