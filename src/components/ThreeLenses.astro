---
// Rebuilt from Jon's mockup: the 5-stage Opportunity->Outcome stepper.
// The WHAT/HOW/DID lens cards are removed for the meantime — Jon's
// pyramid.svg is meant to go in their place, pending layout.
// The mockup's bottom navy banner (See the Gaps/Focus/Improve/Drive) was
// dropped per earlier request — that pattern already exists on this page in
// the Gap Diagram section, so repeating it here read as redundant.
// - Stage 05 (Outcome) is purple in the mockup, but DESIGN.md's locked
//   palette has no purple token. Reused the red already established for
//   "Outcome" in GapDiagram.tsx instead of introducing a new color.
// - Stage 03 (Product) uses the deeper gold (#B08900) already established
//   for the Product stage in gapDiagram.ts, rather than the lighter
//   --yellow token, for cross-section consistency.
import {
  IconSettings,
  IconTargetArrow,
  IconCompass,
  IconChartBar,
  IconCube,
  IconArrowRight,
} from '@tabler/icons-react';

import { base } from '../lib/base';

const stages = [
  {
    num: '01',
    name: 'Opportunity',
    sub: 'What could create value?',
    desc: 'Identify customer needs, market gaps, problems, risks and possibilities.',
    Icon: IconCompass,
    color: '#1A2744',
  },
  {
    num: '02',
    name: 'Investment',
    sub: 'What should we fund?',
    desc: 'Allocate scarce resources to the opportunities with the strongest economic potential.',
    Icon: IconChartBar,
    color: '#E8A030',
  },
  {
    num: '03',
    name: 'Product',
    sub: 'What should we build?',
    desc: 'Translate investment decisions into products, capabilities and features that address the need.',
    Icon: IconCube,
    color: '#B08900',
  },
  {
    num: '04',
    name: 'Delivery',
    sub: 'How efficiently can we deliver?',
    desc: 'Manage flow, capacity, quality, and coordination to deliver value consistently.',
    Icon: IconSettings,
    color: '#174E40',
  },
  {
    num: '05',
    name: 'Outcome',
    sub: 'Did we create value?',
    desc: 'Measure the impact on customers, the business, and the organization.',
    Icon: IconTargetArrow,
    color: '#D14A3E',
  },
];
---

<section id="lenses" class="relative overflow-hidden bg-wash-green py-16 sm:py-24">
  <div class="-mt-16 mb-6 flex h-12 items-center bg-green sm:-mt-24 sm:mb-8">
    <div class="mx-auto w-full max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <p class="text-base font-bold text-white">Our Approach</p>
    </div>
  </div>

  <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
    <div class="text-center">
      <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">The Three Economic Lenses</p>
      <h2 class="mt-3 font-serif text-4xl text-navy sm:text-5xl">
        Three questions. One economic system.
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-foreground/70">
        Every delivery decision is an economic decision. We use three lenses to align what we invest
        in, how we deliver it, and the value we create.
      </p>
      <p class="mt-3">
        <a href={`${base}approach`} class="font-bold text-orange">See the full approach →</a>
      </p>
    </div>

    <div class="mx-auto mt-10 w-full max-w-md">
      <img src={`${base}img/pyramid2.svg`} alt="" class="w-full" />
    </div>

    <div class="mt-14 flex flex-col gap-8 sm:flex-row sm:items-start sm:gap-0">
      {stages.map((stage, i) => (
        <Fragment>
          <div class="flex flex-col items-center text-center sm:flex-1 sm:px-2">
            <div
              class="flex h-14 w-14 items-center justify-center rounded-full text-white"
              style={{ backgroundColor: stage.color }}
            >
              <stage.Icon size={24} strokeWidth={1.8} />
            </div>
            <p class="mt-3 text-sm font-extrabold uppercase tracking-wide text-navy">
              {stage.num} {stage.name}
            </p>
            <p class="mt-1 text-sm font-semibold" style={{ color: stage.color }}>{stage.sub}</p>
            <p class="mt-2 text-xs leading-relaxed text-foreground/70">{stage.desc}</p>
          </div>
          {i < stages.length - 1 && (
            <div class="hidden items-center justify-center sm:flex sm:px-1 sm:pt-5">
              <IconArrowRight class="h-5 w-5 shrink-0 text-line" />
            </div>
          )}
        </Fragment>
      ))}
    </div>
  </div>
</section>
