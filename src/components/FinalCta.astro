---
import { base } from '../lib/base';
const {
  showPortrait = true,
  showMonogram = true,
  transparent = false,
  eyebrow = "Let's Talk",
  body = "Let's explore where value may be leaking in your product delivery system.",
  ctaText = 'Start a conversation →',
  ctaHref = `${base}contact`,
  secondaryCtaText,
  secondaryCtaHref,
  // Per-usage override, e.g. the insight-article closing CTA wanting a
  // taller section than every other page that reuses this component with
  // its default padding.
  paddingClass = 'py-16 sm:py-24',
  // Optional fixed height (e.g. "min-h-[600px]") so this section renders
  // the same size regardless of how long a given page's `body`/headline
  // text happens to be -- padding alone can't guarantee that, since
  // content length varies per usage. When set, also centers the content
  // vertically within that reserved height -- grid, not flex, so the
  // single content child still stretches to its usual full-width block
  // behavior (a flex row's default item sizing would shrink it to fit its
  // content instead). Empty by default so every other page keeps its
  // natural content-driven height.
  minHeightClass = '',
} = Astro.props;
---

<section
  id="contact"
  class:list={[
    'relative',
    paddingClass,
    minHeightClass,
    minHeightClass && 'grid items-center',
    { 'overflow-hidden': showMonogram, 'bg-navy': !transparent },
  ]}
>
  {
    showMonogram && (
      <img
        src={`${base}img/monogram.svg`}
        alt=""
        class="pointer-events-none absolute -right-10 -top-16 w-72 opacity-[0.22] sm:-right-6 sm:-top-20 sm:w-96"
      />
    )
  }

  <div
    class:list={[
      'relative mx-auto flex max-w-[1536px] flex-col items-center gap-[100px] px-6 sm:px-8 lg:px-10 xl:px-14',
      { 'lg:flex-row': showPortrait },
    ]}
  >
    {
      showPortrait && (
        <div class="contact-reveal order-2 mx-auto w-full max-w-[340px] shrink-0 -translate-x-6 opacity-0 transition-all duration-[1600ms] ease-out sm:max-w-[400px] lg:order-1 lg:mx-0 lg:w-auto">
          {/* The width constraint lives here on the wrapper (mx-auto +
              max-w) rather than being inferred from the <img> below --
              putting it on the img instead (as this used to) hit a real
              centering bug where a flex item whose cross-size is driven by
              a percentage-width child renders flush against the parent's
              border edge instead of its padded content edge, so mx-auto
              had no space to distribute even though it read as "correct"
              width-wise. lg:w-auto + lg:mx-0 keeps desktop's existing
              flush-left placement (portrait leading a row, text following
              it) untouched, per Jon. */}
          <img
            src={`${base}img/photography/founder-cta-portrait.png`}
            alt="Jon Encarnacion, Founder & Principal, Coherenz"
            class="w-full lg:max-w-[400px]"
          />
        </div>
      )
    }
    <div
      class:list={[
        'contact-reveal order-1 translate-y-6 opacity-0 transition-all delay-300 duration-[1600ms] ease-out lg:order-2',
        showPortrait ? 'text-left' : 'text-center',
      ]}
    >
      <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">{eyebrow}</p>
      <h2 class="mt-3 font-serif text-4xl text-white sm:text-5xl">
        <slot name="headline">
          Make product delivery
          <br />
          worth more.
        </slot>
      </h2>
      <p class="mt-3 text-white/70">{body}</p>
      <div class:list={['mt-7 flex flex-wrap items-center gap-4', { 'justify-center': !showPortrait }]}>
        <a href={ctaHref} class="inline-block rounded-full bg-primary px-6 py-3 text-sm font-bold text-primary-foreground">
          {ctaText}
        </a>
        {
          secondaryCtaText && secondaryCtaHref && (
            <a
              href={secondaryCtaHref}
              class="inline-block rounded-full border-2 border-orange px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-white/10"
            >
              {secondaryCtaText}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .contact-reveal.is-visible {
    opacity: 1;
    /* Tailwind's -translate-x-6/translate-y-6 utilities (applied via
       class=) set the standalone CSS `translate` property, not
       `transform` -- resetting only `transform` here (as this used to)
       never actually cancels that utility, so the element stayed
       permanently offset by its initial translate amount even once
       "visible". Both need resetting. */
    transform: translate(0, 0);
    translate: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // Fade + slide the portrait and text block in together the first time the
  // section scrolls into view -- same IntersectionObserver-on-init pattern
  // used elsewhere on the page (e.g. HeroDuplicate's video pause), fired
  // once then disconnected rather than re-triggering on every scroll pass.
  function initContactReveal() {
    const section = document.getElementById('contact');
    if (!section) return;
    const items = section.querySelectorAll('.contact-reveal');
    if (!items.length) return;

    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        items.forEach((el) => el.classList.add('is-visible'));
        io.disconnect();
      },
      { threshold: 0.25 }
    );
    io.observe(section);
  }

  initContactReveal();
  document.addEventListener('astro:page-load', initContactReveal);
</script>
