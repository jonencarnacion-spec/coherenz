---
import { base } from '../lib/base';
---

<section id="contact" class="bg-cream py-16 text-center sm:py-24">
  <div class="mx-auto max-w-[1180px] px-6">
    <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">Let's Talk</p>
    <h2 class="mt-3 font-serif text-4xl text-navy sm:text-5xl">Make delivery worth more.</h2>
    <a href={`${base}contact`} class="mt-7 inline-block rounded-full bg-primary px-6 py-3 text-sm font-bold text-primary-foreground">
      Start a conversation →
    </a>
  </div>
</section>
