---
import { base } from '../lib/base';
const {
  showPortrait = true,
  showMonogram = true,
  transparent = false,
  eyebrow = "Let's Talk",
  body = "Let's explore where value may be leaking in your product delivery system.",
  ctaText = 'Start a conversation →',
  ctaHref = `${base}contact`,
  secondaryCtaText,
  secondaryCtaHref,
} = Astro.props;
---

<section
  id="contact"
  class:list={['relative py-16 sm:py-24', { 'overflow-hidden': showMonogram, 'bg-navy': !transparent }]}
>
  {
    showMonogram && (
      <img
        src={`${base}img/monogram.svg`}
        alt=""
        class="pointer-events-none absolute -right-10 -top-16 w-72 opacity-[0.22] sm:-right-6 sm:-top-20 sm:w-96"
      />
    )
  }

  <div
    class:list={[
      'relative mx-auto flex max-w-[1536px] flex-col items-center gap-[100px] px-6 sm:px-8 lg:px-10 xl:px-14',
      { 'lg:flex-row': showPortrait },
    ]}
  >
    {
      showPortrait && (
        <div class="contact-reveal order-2 flex shrink-0 -translate-x-6 justify-start opacity-0 transition-all duration-[1600ms] ease-out lg:order-1">
          <img
            src={`${base}img/photography/founder-cta-portrait.png`}
            alt="Jon Encarnacion, Founder & Principal, Coherenz"
            class="w-full max-w-[340px] sm:max-w-[400px]"
          />
        </div>
      )
    }
    <div
      class:list={[
        'contact-reveal order-1 translate-y-6 opacity-0 transition-all delay-300 duration-[1600ms] ease-out lg:order-2',
        showPortrait ? 'text-left' : 'text-center',
      ]}
    >
      <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">{eyebrow}</p>
      <h2 class="mt-3 font-serif text-4xl text-white sm:text-5xl">
        <slot name="headline">
          Make product delivery
          <br />
          worth more.
        </slot>
      </h2>
      <p class="mt-3 text-white/70">{body}</p>
      <div class="mt-7 flex flex-wrap items-center gap-4">
        <a href={ctaHref} class="inline-block rounded-full bg-primary px-6 py-3 text-sm font-bold text-primary-foreground">
          {ctaText}
        </a>
        {
          secondaryCtaText && secondaryCtaHref && (
            <a
              href={secondaryCtaHref}
              class="inline-block rounded-full border-2 border-white/30 px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-white/10"
            >
              {secondaryCtaText}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .contact-reveal.is-visible {
    opacity: 1;
    transform: translate(0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // Fade + slide the portrait and text block in together the first time the
  // section scrolls into view -- same IntersectionObserver-on-init pattern
  // used elsewhere on the page (e.g. HeroDuplicate's video pause), fired
  // once then disconnected rather than re-triggering on every scroll pass.
  function initContactReveal() {
    const section = document.getElementById('contact');
    if (!section) return;
    const items = section.querySelectorAll('.contact-reveal');
    if (!items.length) return;

    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        items.forEach((el) => el.classList.add('is-visible'));
        io.disconnect();
      },
      { threshold: 0.25 }
    );
    io.observe(section);
  }

  initContactReveal();
  document.addEventListener('astro:page-load', initContactReveal);
</script>
