---
import { base } from '../lib/base';
---

<section class="bg-background py-10">
  <div class="mx-auto max-w-[1180px] px-6">
    <div class="relative overflow-hidden rounded-2xl bg-cream px-8 py-12 sm:px-14 sm:py-16">
      <img src={`${base}img/monogram.svg`} alt="" class="pointer-events-none absolute -right-10 -top-10 w-64 opacity-[0.22]" />
      <div class="relative max-w-xl">
        <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">About Coherenz</p>
        <h3 class="mt-3 font-serif text-3xl text-navy">Every organization has limited delivery capacity.</h3>
        <p class="mt-3 text-foreground/80">
          The question isn't whether you can deliver more. It's whether you are investing that capacity where it matters most.
        </p>
        <a href={`${base}about`} class="mt-4 inline-block font-bold text-orange">Meet Coherenz →</a>
      </div>
    </div>
  </div>
</section>
