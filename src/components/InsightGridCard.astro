---
// Shared card for the /insights page's three editorial sections (Value &
// Investment / Capacity & Flow / System Design). Per "insights page
// flow.docx" §6/13: typography-driven, no tag/category chips, optional
// hover polish reinforcing clickability -- these aren't real links yet
// (no individual article pages exist), same reasoning as the rest of this
// page's cards.
import { base } from '../lib/base';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  Icon: (props: { size?: number; strokeWidth?: number; class?: string }) => any;
}

const { title, description, image, imageAlt, Icon } = Astro.props;
---

<div class="group flex h-full cursor-pointer flex-col overflow-hidden border border-line bg-white transition-all duration-300 hover:-translate-y-1 hover:border-orange/40 hover:shadow-[0_16px_40px_-20px_rgba(26,39,68,0.35)]">
  {image ? (
    <img
      src={`${base}img/photography/${image}`}
      alt={imageAlt}
      class="h-40 w-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
    />
  ) : (
    <div class="flex h-40 w-full items-center justify-center bg-navy">
      <Icon size={32} strokeWidth={1.5} class="text-white/40 transition-transform duration-500 ease-out group-hover:scale-110" />
    </div>
  )}
  <div class="flex flex-1 flex-col p-5">
    <h5 class="text-[15px] font-semibold leading-snug text-navy transition-colors duration-300 group-hover:text-orange">
      {title}
    </h5>
    <p class="mt-2 text-xs text-foreground/70">{description}</p>
  </div>
</div>
