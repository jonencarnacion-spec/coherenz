---
import { base } from '../lib/base';
import { ChallengeCard } from './ui/card-21';

// themeColor values are HSL triplets ("H S% L%") matching DESIGN.md's brand
// hues, converted from their hex tokens (orange #E8A030, blue #2E5077,
// green #174E40) so hsl(var(--theme-color)/alpha) works in the card's
// gradient/glow. Gold substitutes for the reference's purple accent, which
// isn't a locked DESIGN.md color — using the deeper gold (#B08900) already
// established for the Product stage elsewhere on the site.
const problems = [
  {
    q: 'Are you investing in the right things?',
    label: 'Product & Portfolio Strategy',
    img: 'solve-strategy.jpg',
    pain: "We're investing in the wrong things.",
    themeColor: '36 80% 55%',
  },
  {
    q: 'Are you getting enough value from your delivery capacity?',
    label: 'Product Delivery Economics™',
    img: 'solve-delivery-economics.jpg',
    themeColor: '212 44% 32%',
  },
  {
    q: 'Is your delivery system struggling to keep up?',
    label: 'Delivery Stabilization',
    img: 'solve-delivery-stabilization.jpg',
    themeColor: '47 100% 35%',
  },
  {
    q: 'Is your organization ready to scale?',
    label: 'Product Operating Model',
    img: 'solve-operating-model.jpg',
    themeColor: '165 55% 20%',
  },
];

const cardItems = problems.map((p) => ({
  imageUrl: `${base}img/photography/${p.img}`,
  headline: p.pain ?? p.label,
  label: p.pain ? p.label : p.q,
  href: `${base}services`,
  themeColor: p.themeColor,
  // Split top-image/bottom-text layout, applied to all four cards.
  splitLayout: true,
  // White-frame photo inset (Deloitte reference), now on all four cards.
  framedImage: true,
}));
---

<section id="services" class="bg-wash-blue py-16 sm:py-24">
  <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
    <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">What We Help Solve</p>
    <h2 class="mt-3 font-serif text-4xl text-navy sm:text-5xl">Four questions we help you answer.</h2>
    <p class="mt-3">
      <a href={`${base}services`} class="font-bold text-orange">See all services →</a>
    </p>
  </div>

  <div class="mx-auto mt-14 max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
    <div class="rounded-3xl border-[1.5px] border-[#BFC7D1] px-6 py-6 sm:px-10 sm:py-8">
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {cardItems.map((item) => (
          <div class="h-[420px]">
            <ChallengeCard {...item} />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
