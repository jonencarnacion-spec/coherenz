---
import { base } from '../lib/base';
import { ChallengeCard } from './ui/card-21';

// themeColor values are HSL triplets ("H S% L%") matching DESIGN.md's brand
// hues, converted from their hex tokens (orange #E8A030, blue #2E5077,
// green #174E40) so hsl(var(--theme-color)/alpha) works in the card's
// gradient/glow. Gold substitutes for the reference's purple accent, which
// isn't a locked DESIGN.md color — using the deeper gold (#B08900) already
// established for the Product stage elsewhere on the site.
const problems = [
  {
    q: 'Are you investing in the right things?',
    label: 'Product & Portfolio Strategy',
    img: 'solve-strategy.jpg',
    pain: "We're investing in the wrong things.",
    desc: 'Align strategy and invest in what creates the most value.',
    themeColor: '36 80% 55%',
  },
  {
    q: 'Are you getting enough value from your delivery capacity?',
    label: 'Product Delivery Economics™',
    img: 'solve-delivery-economics.jpg',
    pain: "We're not getting enough value from capacity.",
    desc: 'Improve flow and reduce waste to turn capacity into measurable value.',
    themeColor: '212 44% 32%',
  },
  {
    q: 'Is your delivery system struggling to keep up?',
    label: 'Delivery Stabilization',
    img: 'solve-delivery-stabilization.jpg',
    pain: 'Delivery is struggling to keep up.',
    desc: 'Unblock constraints and stabilize flow to restore predictable delivery.',
    themeColor: '47 100% 35%',
  },
  {
    q: 'Is your organization ready to scale?',
    label: 'Product Operating Model',
    img: 'solve-operating-model.jpg',
    pain: "We've outgrown our operating model.",
    desc: 'Design the operating model and governance to scale product impact.',
    themeColor: '165 55% 20%',
  },
];

const cardItems = problems.map((p) => ({
  imageUrl: `${base}img/photography/${p.img}`,
  headline: p.pain ?? p.label,
  label: p.pain ? p.label : p.q,
  desc: p.pain ? p.desc : undefined,
  href: `${base}services`,
  themeColor: p.themeColor,
  // Left-align headline/caption/desc text, now applied to all four cards.
  leftAlignText: true,
  // Split top-image/bottom-text layout, applied to all four cards.
  splitLayout: true,
  // White-frame photo inset (Deloitte reference), now on all four cards.
  framedImage: true,
  // Swap caption/CTA position, now applied to all four cards. Headline
  // gets a fixed min-height (card-21.tsx) so the CTA lands at the same
  // Y position across all cards regardless of headline length.
  swapLabelCta: true,
  // Same 2-column, no-fixed-headline-floor layout as the Services page's
  // "Start With the Problem. Choose the Right Engagement." Programs grid.
  compactHeadline: true,
}));
---

<section id="services" class="bg-wash-blue pt-12 pb-10 sm:pt-14 sm:pb-12">
  <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
    <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">Which problem looks most like yours?</p>
    <h2 class="mt-2 font-serif text-4xl text-navy sm:text-5xl">
      Every organization hits a different ceiling.
      <br />
      Where are you feeling the most friction?
    </h2>
    <p class="mt-2 max-w-2xl text-foreground/70">
      Your challenge determines where value is being lost. Choose the one that resonates most to see
      how we help leaders close the gap.
    </p>
    <p class="mt-2">
      <a href={`${base}diagnostic`} class="font-bold text-orange">Take the diagnostic →</a>
    </p>
  </div>

  <div class="mx-auto mt-[50px] max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {cardItems.map((item) => (
        <div class="h-[384px]">
          <ChallengeCard {...item} />
        </div>
      ))}
    </div>
  </div>
</section>
