---
import { base } from '../lib/base';
const problems = [
  { q: 'Are you investing in the right things?', label: 'Product & Portfolio Strategy', img: 'solve-strategy.jpg' },
  { q: 'Are you getting enough value from your delivery capacity?', label: 'Product Delivery Economics™', img: 'solve-delivery-economics.jpg' },
  { q: 'Is your delivery system struggling to keep up?', label: 'Delivery Stabilization', img: 'solve-delivery-stabilization.jpg' },
  { q: 'Is your organization ready to scale?', label: 'Product Operating Model', img: 'solve-operating-model.jpg' },
];
---

<section id="services" class="bg-navy py-16 sm:py-24">
  <div class="mx-auto max-w-[1180px] px-6">
    <p class="text-sm font-bold uppercase tracking-[0.375em] text-yellow">What We Help Solve</p>
    <h2 class="mt-3 font-serif text-4xl text-white sm:text-5xl">Four questions we help you answer.</h2>
    <p class="mt-3">
      <a href={`${base}services`} class="font-bold text-orange">See all services →</a>
    </p>
  </div>

  <div class="mx-auto mt-14 grid max-w-[1400px] grid-cols-1 gap-14 px-6 sm:grid-cols-2 lg:grid-cols-4">
    {problems.map((item) => (
      <div class="flex flex-col items-center text-center">
        <div class="relative aspect-square w-full max-w-[280px]">
          <div class="absolute inset-0 scale-[1.2] rounded-full border border-white/15" />
          <div
            class="absolute inset-0 rounded-full bg-cover bg-center shadow-xl"
            style={`background-image:url('${base}img/photography/${item.img}')`}
          />
        </div>
        <h4 class="mt-8 max-w-[220px] font-serif text-xl text-white">{item.q}</h4>
        <p class="mt-3 text-sm font-semibold text-white/65">{item.label}</p>
      </div>
    ))}
  </div>
</section>
