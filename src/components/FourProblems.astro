---
import { base } from '../lib/base';
import ColorChangeCards from './ui/color-change-card';

const problems = [
  {
    q: 'Are you investing in the right things?',
    label: 'Product & Portfolio Strategy',
    img: 'solve-strategy.jpg',
    desc: 'Align strategy, prioritize opportunities, and invest in what creates the most value.',
    pain: "We're investing in the wrong things.",
  },
  { q: 'Are you getting enough value from your delivery capacity?', label: 'Product Delivery Economics™', img: 'solve-delivery-economics.jpg' },
  { q: 'Is your delivery system struggling to keep up?', label: 'Delivery Stabilization', img: 'solve-delivery-stabilization.jpg' },
  { q: 'Is your organization ready to scale?', label: 'Product Operating Model', img: 'solve-operating-model.jpg' },
];

const cardItems = problems.map((p) => ({
  heading: p.label,
  description: p.desc ?? p.q,
  imgSrc: `${base}img/photography/${p.img}`,
  pain: p.pain,
}));
---

<section id="services" class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-[1180px] px-6">
    <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">What We Help Solve</p>
    <h2 class="mt-3 font-serif text-4xl text-navy sm:text-5xl">Four questions we help you answer.</h2>
    <p class="mt-3">
      <a href={`${base}services`} class="font-bold text-orange">See all services →</a>
    </p>
  </div>

  <div class="mt-14">
    <ColorChangeCards items={cardItems} client:visible />
  </div>
</section>
