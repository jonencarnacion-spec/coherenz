---
// Article hero. Rebuilt per Jon's reference to McKinsey's feature-article
// heroes: full-bleed, photographic, alive -- not the flat navy title band
// the doc's own Design Direction called for. The photography here isn't
// generic stock (which DESIGN.md and the doc both rule out) -- it's the
// same curated, conceptual image already assigned to each article on the
// homepage teaser and /insights index (src/data/insightsContent.ts), reused
// here as the hero background rather than a new asset. Falls back to a
// flat navy treatment (still animated, still carries the monogram) for any
// article that doesn't have a curated photo yet -- surfaced to Jon rather
// than filled with an unrelated stock image.
import { base } from '../../lib/base';
import { IconArrowLeft } from '@tabler/icons-react';

interface Props {
  eyebrow: string;
  title: string;
  subhead: string;
  readTime: string;
  heroImage?: string;
  heroImageAlt?: string;
}
const { eyebrow, title, subhead, readTime, heroImage, heroImageAlt } = Astro.props;
---

<header class="relative flex min-h-[58vh] items-end overflow-hidden bg-navy sm:min-h-[64vh]">
  {
    heroImage ? (
      <>
        <img src={`${base}img/photography/${heroImage}`} alt={heroImageAlt ?? ''} class="absolute inset-0 h-full w-full object-cover" />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy via-navy/80 to-navy/30" />
      </>
    ) : (
      <img
        src={`${base}img/monogram.svg`}
        alt=""
        class="pointer-events-none absolute -right-10 -top-16 w-72 opacity-[0.18] sm:-right-6 sm:-top-20 sm:w-[28rem]"
      />
    )
  }

  <div class="relative mx-auto w-full max-w-[1536px] px-6 pb-14 pt-28 sm:px-8 sm:pb-20 lg:px-10 xl:px-14">
    <a href={`${base}insights`} class="hero-reveal inline-flex items-center gap-2 text-sm font-bold text-white/60 hover:text-orange">
      <IconArrowLeft size={16} stroke={2} />
      All Insights
    </a>
    <p class="hero-reveal mt-6 text-sm font-bold uppercase tracking-[0.375em] text-orange">{eyebrow}</p>
    <h1 class="hero-reveal mt-5 max-w-2xl font-serif text-4xl leading-[1.1] text-white sm:text-6xl">{title}</h1>
    <p class="hero-reveal mt-5 max-w-2xl text-lg text-white/80 sm:text-xl">{subhead}</p>
    <p class="hero-reveal mt-8 text-xs font-semibold uppercase tracking-wide text-white/50">{readTime}</p>
  </div>
</header>

<style>
  .hero-reveal {
    opacity: 0;
    transform: translateY(14px);
    animation: hero-reveal 800ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .hero-reveal:nth-child(1) { animation-delay: 0ms; }
  .hero-reveal:nth-child(2) { animation-delay: 90ms; }
  .hero-reveal:nth-child(3) { animation-delay: 160ms; }
  .hero-reveal:nth-child(4) { animation-delay: 240ms; }
  .hero-reveal:nth-child(5) { animation-delay: 320ms; }

  @keyframes hero-reveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-reveal {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
