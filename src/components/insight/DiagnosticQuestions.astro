---
// §11 DIAGNOSTIC SECTION — lets the reader apply the thinking to their own
// organization. Doc calls for strong visual treatment (question cards,
// large typography) that feels diagnostic rather than like a checklist --
// large numerals + generous padding instead of plain list markers.
interface Props {
  label: string;
  prompt: string;
  questions: string[];
}
const { label, prompt, questions } = Astro.props;
---

<section class="bg-navy py-16 sm:py-24">
  <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
    <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">{label}</p>
    <h2 class="mt-3 max-w-2xl font-serif text-3xl text-white sm:text-4xl">{prompt}</h2>

    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {questions.map((q, i) => (
        <div class="flex items-start gap-4 border border-white/15 bg-white/5 p-5">
          <span class="font-serif text-2xl text-orange">{String(i + 1).padStart(2, '0')}</span>
          <p class="mt-1 text-white/90">{q}</p>
        </div>
      ))}
    </div>
  </div>
</section>
