---
// §11 DIAGNOSTIC SECTION — lets the reader apply the thinking to their own
// organization. Doc calls for strong visual treatment (question cards,
// large typography) that feels diagnostic rather than like a checklist --
// large numerals + generous padding instead of plain list markers.
//
// Background, section sizing, and card shell all copied from services.astro's
// "Product Delivery Is a System" section (the systemDimensions row) --
// same coherenz-view-bg.jpg + gradient, same py-16/sm:py-24 + mt-[50px] +
// heading scale, same border-white/50-on-bg-navy/50 flex-1 cards with a
// circular icon-ring badge -- minus that section's connecting "→" arrows
// between cards, per Jon's call. The ring holds the question number since
// this diagnostic doesn't have a per-question icon the way the system
// dimensions do.
import { base } from '../../lib/base';

interface Props {
  label: string;
  prompt: string;
  questions: string[];
}
const { label, prompt, questions } = Astro.props;
---

<section class="relative overflow-hidden bg-navy py-[132px] text-white sm:py-[164px]">
  <img src={`${base}img/coherenz-view-bg.jpg`} alt="" class="absolute inset-0 h-full w-full object-cover" />
  <div class="absolute inset-0 bg-gradient-to-r from-navy/90 to-navy/30" />
  <div class="relative mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
    <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">{label}</p>
    <h2 class="mt-3 max-w-2xl font-serif text-4xl text-white sm:text-5xl">{prompt}</h2>

    <div class="diagnostic-grid mt-[50px] flex flex-col gap-3 lg:flex-row lg:items-stretch lg:gap-4">
      {questions.map((q, i) => (
        <div class="diagnostic-card flex flex-1 flex-col gap-3 border border-white/50 bg-navy/50 p-5">
          <span class="flex h-10 w-10 items-center justify-center rounded-full border border-orange/40 font-serif text-lg text-orange">
            {String(i + 1).padStart(2, '0')}
          </span>
          <p class="text-base text-white/70">{q}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Float-in from the left, one card at a time: same character as the
     hero's float-in (InsightHeader.astro) -- 28px travel, 1500ms, strong
     ease-out -- just horizontal instead of vertical, and sequenced
     (delay == duration) since these are five distinct diagnostic prompts,
     not a single group entrance. Triggered on scroll into view since this
     section sits below the fold. */
  .diagnostic-card {
    opacity: 0;
    transform: translateX(-28px);
    transition:
      opacity 1500ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 1500ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .diagnostic-card:nth-of-type(1) { transition-delay: 0ms; }
  .diagnostic-card:nth-of-type(2) { transition-delay: 1500ms; }
  .diagnostic-card:nth-of-type(3) { transition-delay: 3000ms; }
  .diagnostic-card:nth-of-type(4) { transition-delay: 4500ms; }
  .diagnostic-card:nth-of-type(5) { transition-delay: 6000ms; }

  .diagnostic-card.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .diagnostic-card {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initDiagnosticReveal() {
    const grid = document.querySelector('.diagnostic-grid');
    if (!grid) return;
    const cards = grid.querySelectorAll('.diagnostic-card');
    if (!cards.length) return;

    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        cards.forEach((el) => el.classList.add('is-visible'));
        io.disconnect();
      },
      { threshold: 0.2 }
    );
    io.observe(grid);
  }

  initDiagnosticReveal();
  document.addEventListener('astro:page-load', initDiagnosticReveal);
</script>
