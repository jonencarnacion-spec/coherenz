---
// §13 WHAT LEADERS SHOULD DO DIFFERENTLY + §14 CLOSING STATEMENT — combined
// since the closing line is the natural final beat of this same section,
// not a separate page break. "Instead of asking X, ask Y" contrast per the
// doc's example, then 3 practical steps, then a visually prominent closing
// statement (large italic serif, same treatment the site already uses for
// the /insights page's editorial perspective break).
interface Step {
  number: string;
  title: string;
  body: string;
}
interface Props {
  heading: string;
  insteadOf: string;
  ask: string;
  steps: Step[];
  closing: string;
}
const { heading, insteadOf, ask, steps, closing } = Astro.props;
---

<section class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
    <h2 class="float-up font-serif text-3xl text-navy sm:text-4xl">{heading}</h2>

    <div class="mt-8 max-w-2xl space-y-3">
      <p class="text-foreground/50">
        Instead of asking: <span class="italic">"{insteadOf}"</span>
      </p>
      <p class="text-lg font-medium text-navy">
        Ask: <span class="italic text-orange">"{ask}"</span>
      </p>
    </div>

    <div class="mt-10 flex flex-col gap-4 sm:flex-row">
      {steps.map((step) => (
        <div class="flex-1 border border-line border-t-4 border-t-orange bg-white p-6">
          <p class="text-xs font-bold uppercase tracking-wide text-orange">{step.number}</p>
          <p class="mt-2 font-serif text-lg text-navy">{step.title}</p>
          <p class="mt-2 text-sm text-foreground/70">{step.body}</p>
        </div>
      ))}
    </div>

    <p class="float-up mx-auto mt-16 max-w-2xl border-t border-line pt-12 text-center font-serif text-2xl italic leading-snug text-navy sm:text-3xl">
      {closing}
    </p>
  </div>
</section>

<style>
  /* Float-in from the bottom, same character as CoherenzPerspective.astro
     (28px travel, 1500ms, strong ease-out). Heading and closing quote are
     far apart on the page, so each gets its own IntersectionObserver and
     reveals independently when IT scrolls into view -- not tied to a
     shared trigger. */
  .float-up {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 1500ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 1500ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .float-up.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .float-up {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initFloatReveal() {
    document.querySelectorAll<HTMLElement>('.float-up').forEach((el) => {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          el.classList.add('is-visible');
          io.disconnect();
        },
        { threshold: 0.2 }
      );
      io.observe(el);
    });
  }

  initFloatReveal();
  document.addEventListener('astro:page-load', initFloatReveal);
</script>
