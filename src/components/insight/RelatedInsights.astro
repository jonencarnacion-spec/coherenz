---
// §16 RELATED INSIGHTS — reuses the same InsightGridCard component as the
// main /insights page (doc: "creates continuity between the article and
// the Insights index"). All 10 articles now carry a heroImage, so related
// cards show that same photo as their thumbnail; IconBulb stays as the
// fallback InsightGridCard already uses for any article without one.
import InsightGridCard from '../InsightGridCard.astro';
import { IconBulb } from '@tabler/icons-react';
import type { InsightArticle } from '../../data/insightArticles';

interface Props {
  articles: InsightArticle[];
}
const { articles } = Astro.props;
---

<section class="bg-wash-green py-16 sm:py-24">
  <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
    <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">Continue Exploring</p>
    <div class="mt-8 grid max-w-3xl grid-cols-1 gap-6 sm:grid-cols-2">
      {articles.map((a) => (
        <InsightGridCard
          title={a.title}
          description={a.subhead}
          slug={a.slug}
          image={a.heroImage}
          imageAlt={a.heroImageAlt}
          Icon={IconBulb}
        />
      ))}
    </div>
  </div>
</section>
