---
// Duplicate of Hero.astro, placed directly after it per request -- same
// copy, background swapped to a video (home-hero-intro.mp4, from
// "video options/intro vids/" -- not DESIGN.md §10's flagged stock clip)
// for comparison against the orbital canvas. Gradient overlay uses the
// standard --color-navy token instead of the earlier white-to-navy
// version, so the two sections read as one continuous dark passage as you
// scroll between them. Heading downgraded h1 -> h2 since a page should
// only have one h1 (Hero.astro already owns it).
import { base } from '../lib/base';
---

<section id="hero-duplicate" class="relative z-10 flex min-h-screen items-end overflow-hidden bg-[#16213A]">
  <video
    id="hero-duplicate-video"
    class="absolute inset-0 h-full w-full object-cover"
    style="transform: translateZ(0);"
    preload="auto"
    autoplay
    muted
    loop
    playsinline
  >
    <source src={`${base}video/home-hero-intro.mp4`} type="video/mp4" />
  </video>
  <div class="absolute inset-0 bg-gradient-to-b from-navy/20 via-navy/60 to-navy/95" />

  <div class="relative mx-auto w-full max-w-[1180px] px-6 py-32">
    <div class="float-up mx-auto max-w-[1100px] text-center">
      <h2 class="mt-4 font-serif text-[52px] leading-[1.25] text-white">
        Making product delivery make economic sense.
      </h2>
      <p class="mx-auto mt-4 max-w-[980px] text-[18px] text-white/80">
        Delivery capacity is too often disconnected from the value it should create. Coherenz exists
        to close that gap—connecting strategy, execution, and outcomes so leaders can prioritize what
        matters, invest with confidence, and see measurable, lasting results.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href={`${base}about`} class="w-40 rounded-full border-2 border-orange px-6 py-3 text-center text-sm font-bold text-orange transition-colors hover:bg-orange/10">
          Who we are
        </a>
        <a href={`${base}approach`} class="w-40 rounded-full border-2 border-orange px-6 py-3 text-center text-sm font-bold text-orange transition-colors hover:bg-orange/10">
          Our Approach
        </a>
        <a href={`${base}programs`} class="w-40 rounded-full border-2 border-orange px-6 py-3 text-center text-sm font-bold text-orange transition-colors hover:bg-orange/10">
          Our programs
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // A looping autoplay video keeps decoding/buffering frames indefinitely
  // even while scrolled far out of view -- pause it off-screen the same way
  // the Hero canvas above it is paused, and resume on scroll-back.
  // rootMargin gives it a head start: play() fires (and the video starts
  // buffering/decoding) while the section is still 400px below the
  // viewport, so it's already running by the time it scrolls into view
  // instead of cold-starting from a fully-paused, unbuffered state.
  function initHeroDuplicateVideoPause() {
    const section = document.getElementById('hero-duplicate');
    const video = document.getElementById('hero-duplicate-video') as HTMLVideoElement | null;
    if (!section || !video) return;

    // Scrolling back and forth across the rootMargin boundary can fire
    // play() and pause() faster than play()'s promise resolves -- Chrome
    // throws "play() request was interrupted by a call to pause()" and can
    // leave the element stuck on a blank frame until something else (e.g.
    // a tab visibility change) forces it to resync. Track the in-flight
    // play() and only pause() once it's actually settled.
    let pendingPlay: Promise<void> | null = null;

    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          pendingPlay = video.play().catch(() => {}).finally(() => {
            pendingPlay = null;
          });
        } else if (pendingPlay) {
          pendingPlay.then(() => video.pause());
        } else {
          video.pause();
        }
      },
      { rootMargin: '400px 0px' }
    );
    io.observe(section);
  }

  initHeroDuplicateVideoPause();
  document.addEventListener('astro:page-load', initHeroDuplicateVideoPause);
</script>

<style>
  /* Float-in from the bottom, same character used across the site
     (CoherenzPerspective.astro, ActionAndClosing.astro, insights.astro):
     28px travel, 1500ms, strong ease-out. IntersectionObserver-triggered
     since this section sits below the first hero, not in the initial
     viewport on load. */
  .float-up {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 1500ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 1500ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .float-up.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .float-up {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initFloatUpReveal() {
    document.querySelectorAll<HTMLElement>('.float-up').forEach((el) => {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          el.classList.add('is-visible');
          io.disconnect();
        },
        { threshold: 0.2 }
      );
      io.observe(el);
    });
  }

  initFloatUpReveal();
  document.addEventListener('astro:page-load', initFloatUpReveal);
</script>
