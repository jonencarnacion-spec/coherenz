---
import { base } from '../lib/base';
---

<section class="bg-background py-10">
  <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
    <div class="relative overflow-hidden rounded-2xl bg-green px-8 py-12 text-white sm:px-14 sm:py-16">
      <img src={`${base}img/monogram.svg`} alt="" class="pointer-events-none absolute -right-10 -top-10 w-64 opacity-20" />
      <div class="relative max-w-xl">
        <p class="text-sm font-bold uppercase tracking-[0.375em] text-yellow">Coherenz Perspectives</p>
        <h3 class="mt-3 font-serif text-3xl text-white">Better decisions. Stronger outcomes.</h3>
        <p class="mt-3 text-white/80">
          Timely thinking on the economics of product delivery — to help you close the gap between strategy and results.
        </p>
        <a href={`${base}insights`} class="mt-4 inline-block font-bold text-yellow">Read the perspective →</a>
      </div>
    </div>
  </div>
</section>
