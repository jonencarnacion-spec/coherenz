---
import { base } from '../lib/base';
import ElegantCarousel from './ui/elegant-carousel';
---

<section class="bg-wash-green py-8">
  <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
    <div class="hero-float-left max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">Our Commitment</p>
      <h2 class="mt-3 font-serif text-4xl text-navy sm:text-5xl">
        The point isn't to deliver more.
        <br />
        It's to make delivery worth more.
      </h2>
      <p class="mt-3 text-foreground/70">
        Every engagement is grounded in better decisions, stronger economics, and greater value from the capacity
        you already have.
      </p>
      <p class="mt-3">
        <a href={`${base}approach`} class="font-bold text-orange">See what we promise →</a>
      </p>
    </div>

    <div class="mt-[100px]">
      <ElegantCarousel client:visible wrapperBg="#FFFFFF" />
    </div>
  </div>
</section>

<style>
  /* Float-in from the left, same character as insights.astro's hero and
     the other page heroes: 28px travel, 1500ms, strong ease-out.
     IntersectionObserver-triggered since this section sits below the fold. */
  .hero-float-left {
    opacity: 0;
    transform: translateX(-28px);
    transition:
      opacity 1500ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 1500ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .hero-float-left.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-float-left {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initHeroFloatLeft() {
    document.querySelectorAll<HTMLElement>('.hero-float-left').forEach((el) => {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          el.classList.add('is-visible');
          io.disconnect();
        },
        { threshold: 0.2 }
      );
      io.observe(el);
    });
  }

  initHeroFloatLeft();
  document.addEventListener('astro:page-load', initHeroFloatLeft);
</script>
