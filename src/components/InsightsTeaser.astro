---
// Real copy + photos supplied by Jon (assets/image options/insights/), replacing
// the earlier placeholder set. Source text file also sketched a "100% BUSY ≠
// 100% VALUE" graphic as a future design asset idea ("perhaps a small visual...
// that would be a fantastic little Coherenz graphic") -- that's not finalized
// copy or a ready asset, so it's intentionally left out here rather than
// fabricated; flag to Jon if he wants it built out separately.
// Data lives in src/data/insightsContent.ts, shared with the /insights page.
import { base } from '../lib/base';
import { IconArrowUpRight, IconBulb } from '@tabler/icons-react';
import { topInsight, insights } from '../data/insightsContent';
import InsightGridCard from './InsightGridCard.astro';
---

<section id="insights" class="bg-wash-green py-10 sm:py-16">
  <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
    <div class="hero-float-left">
      <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">Coherenz Thinking</p>
      <h2 class="mt-2 font-serif text-4xl text-navy sm:text-5xl">Perspectives worth your time.</h2>
      <p class="mt-2">
        <a href={`${base}insights`} class="font-bold text-orange">See all insights →</a>
      </p>
    </div>

    <a
      href={`${base}insights/${topInsight.slug}`}
      class="group mt-[100px] grid cursor-pointer grid-cols-1 border border-line md:grid-cols-2 md:h-[563px]"
    >
      <div class="flex flex-col justify-start overflow-y-auto bg-white p-6 sm:p-8">
        <p class="text-xs font-bold uppercase tracking-wide text-orange">{topInsight.tag}</p>
        <h3 class="mt-2 font-serif text-3xl text-navy sm:text-4xl">{topInsight.title}</h3>
        <p class="mt-2 font-medium text-navy/80">{topInsight.subhead}</p>
        <p class="mt-2 text-sm text-foreground/70">{topInsight.body}</p>
        <span class="mt-4 inline-flex items-center gap-2 font-bold text-orange">
          <IconArrowUpRight size={20} stroke={2} class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          Read the perspective
        </span>
      </div>
      <div class="min-h-[240px] overflow-hidden md:h-full">
        <img
          src={`${base}img/photography/${topInsight.image}`}
          alt={topInsight.imageAlt}
          class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
        />
      </div>
    </a>

    <div class="mt-[100px] grid grid-cols-1 gap-4 sm:grid-cols-3">
      {insights.map(({ title, description, image, imageAlt, slug }) => (
        <InsightGridCard title={title} description={description} image={image} imageAlt={imageAlt} slug={slug} Icon={IconBulb} />
      ))}
    </div>
  </div>
</section>

<style>
  /* Float-in from the left, same character as insights.astro's hero and
     the other page heroes: 28px travel, 1500ms, strong ease-out.
     IntersectionObserver-triggered since this section sits below the fold. */
  .hero-float-left {
    opacity: 0;
    transform: translateX(-28px);
    transition:
      opacity 1500ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 1500ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .hero-float-left.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-float-left {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initHeroFloatLeft() {
    document.querySelectorAll<HTMLElement>('.hero-float-left').forEach((el) => {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          el.classList.add('is-visible');
          io.disconnect();
        },
        { threshold: 0.2 }
      );
      io.observe(el);
    });
  }

  initHeroFloatLeft();
  document.addEventListener('astro:page-load', initHeroFloatLeft);
</script>
