---
// Homepage teaser. The real click-to-reveal diagnostic funnel lives on the
// /diagnostic page and is the only one of the three that becomes a React
// island, per MIGRATION.md — this elastic-gallery is a second, separate
// island (hover/click interactivity for the accordion effect).
import { ElasticGallery } from './ui/elastic-gallery';
import { base } from '../lib/base';

const dimensions = [
  {
    id: '01',
    title: 'Value',
    q: 'Are we building the right things?',
    src: `${base}img/photography/diagnostic-value.jpg`,
    alt: 'Reviewing quarterly progress and revenue metrics',
  },
  {
    id: '02',
    title: 'Flow',
    q: 'How efficiently does work move?',
    src: `${base}img/photography/diagnostic-flow.jpg`,
    alt: 'Delivery stabilization work in progress',
  },
  {
    id: '03',
    title: 'Capacity',
    q: 'Where is our delivery capacity actually going?',
    src: `${base}img/photography/diagnostic-capacity.jpg`,
    alt: 'Product delivery economics assessment',
  },
  {
    id: '04',
    title: 'Quality',
    q: 'How much capacity is consumed by defects and rework?',
    src: `${base}img/photography/diagnostic-quality.jpg`,
    alt: 'Reviewing the product operating model',
  },
  {
    id: '05',
    title: 'Coordination',
    q: 'How much effort is lost to dependencies and organizational friction?',
    src: `${base}img/photography/diagnostic-coordination.jpg`,
    alt: 'Executive workshop session',
  },
];
---

<section id="diagnostic-teaser" class="bg-navy py-16 sm:py-24">
  <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
    <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">The Coherenz Diagnostic</p>
    <h2 class="mt-3 font-serif text-4xl text-white sm:text-5xl">Where is value being lost?</h2>
    <p class="mt-3">
      <a href={`${base}diagnostic`} class="font-bold text-orange">Take the diagnostic →</a>
    </p>

    <div class="mt-10">
      <ElasticGallery items={dimensions} href={`${base}diagnostic`} client:visible />
    </div>
  </div>
</section>
