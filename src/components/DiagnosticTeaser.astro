---
// Homepage teaser. The real click-to-reveal diagnostic funnel lives on the
// /diagnostic page and is the only one of the three that becomes a React
// island, per MIGRATION.md — this elastic-gallery is a second, separate
// island (hover/click interactivity for the accordion effect).
import { ElasticGallery } from './ui/elastic-gallery';
import { base } from '../lib/base';
import { IconSearch, IconEye, IconTarget, IconTrendingUp, IconTargetArrow } from '@tabler/icons-react';

const promises = [
  { Icon: IconEye, title: 'See', desc: 'Make hidden friction visible and measurable.' },
  { Icon: IconTarget, title: 'Focus', desc: 'Prioritize the highest-value leaks.' },
  { Icon: IconTrendingUp, title: 'Improve', desc: 'Remove friction and improve flow.' },
  { Icon: IconTargetArrow, title: 'Drive', desc: 'Turn delivery into measurable outcomes.' },
];

const dimensions = [
  {
    id: '01',
    title: 'Value',
    q: 'Are we building the right things?',
    subtitle: 'Are we focused on opportunities that create the most customer, business, and strategic value?',
    src: `${base}img/photography/diagnostic-value.jpg`,
    alt: 'Reviewing quarterly progress and revenue metrics',
  },
  {
    id: '02',
    title: 'Flow',
    q: 'How efficiently does work move?',
    subtitle: 'How smoothly does work move from idea to outcome? Where are the bottlenecks and delays?',
    src: `${base}img/photography/diagnostic-flow.jpg`,
    alt: 'Reviewing the product operating model',
  },
  {
    id: '03',
    title: 'Capacity',
    q: 'Where is our delivery capacity actually going?',
    subtitle: 'How is our capacity allocated today? How much is spent on non-value-adding or low-value work?',
    src: `${base}img/photography/diagnostic-capacity.jpg`,
    alt: 'Product delivery economics assessment',
  },
  {
    id: '04',
    title: 'Quality',
    q: 'How much capacity is consumed by defects and rework?',
    subtitle: 'How much effort is lost to defects, rework, and technical debt instead of creating new value?',
    src: `${base}img/photography/diagnostic-quality.jpg`,
    alt: 'Delivery stabilization work in progress',
  },
  {
    id: '05',
    title: 'Coordination',
    q: 'How much effort is lost to dependencies and organizational friction?',
    subtitle:
      'How much time, capacity, and cognitive load is consumed by handoffs, waiting, unclear priorities, and organizational complexity?',
    src: `${base}img/photography/diagnostic-coordination.jpg`,
    alt: 'Executive workshop session',
  },
];
---

<section id="diagnostic-teaser" class="bg-wash-blue pt-12 pb-10 sm:pt-14 sm:pb-12">
  <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
    <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">The Coherenz Diagnostic</p>
    <h2 class="mt-2 font-serif text-4xl text-navy sm:text-5xl">Where is your delivery economics breaking down?</h2>
    <p class="mt-2 max-w-2xl text-foreground/70">
      The Coherenz Diagnostic reveals where economic leakage occurs across five critical dimensions of
      your product delivery system.
    </p>
    <p class="mt-2">
      <a href={`${base}diagnostic`} class="font-bold text-orange">Take the diagnostic →</a>
    </p>

    <div class="mt-[50px]">
      <ElasticGallery items={dimensions} client:visible />
    </div>

    <div class="relative mt-6 flex flex-col gap-8 overflow-hidden bg-blue px-8 py-5 text-white sm:flex-row sm:items-center">
      <img
        src={`${base}img/monogram.svg`}
        alt=""
        class="pointer-events-none absolute -right-10 -top-10 w-64 opacity-20"
      />
      <div class="relative flex items-center gap-4 sm:flex-[1.3]">
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full border border-orange/40">
          <IconSearch className="h-6 w-6 text-orange" />
        </div>
        <p class="text-lg font-medium">
          The Coherenz Diagnostic makes hidden economic leakage <span class="text-orange">visible</span> — so we
          can focus where it matters most.
        </p>
      </div>
      <div class="relative grid grid-cols-2 gap-6 sm:flex sm:flex-[1.6] sm:items-start">
        {promises.map(({ Icon, title, desc }) => (
          <div>
            <Icon size={30} strokeWidth={1.8} className="text-orange" />
            <strong class="mt-2 block text-sm uppercase tracking-wide">{title}</strong>
            <span class="mt-1 block text-xs text-white/70">{desc}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
