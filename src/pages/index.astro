---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import HeroDuplicate from '../components/HeroDuplicate.astro';
import GapDiagram from '../components/GapDiagram.tsx';
import FourProblems from '../components/FourProblems.astro';
import ThreeLenses from '../components/ThreeLenses.astro';
import DiagnosticTeaser from '../components/DiagnosticTeaser.astro';
import PdeosWheel from '../components/PdeosWheel.tsx';
import Perspectives from '../components/Perspectives.astro';
import InsightsTeaser from '../components/InsightsTeaser.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Coherenz — Delivery is an investment. Treat it like one."
  description="Coherenz helps product organizations make better investment, prioritization and delivery decisions—turning delivery capacity into measurable business value."
>
  <Nav />
  <div class="relative isolate">
    <!--
      Hero is `position: sticky`, which stays "stuck" for as long as its
      containing block (this div) is being scrolled through — not just its
      own height — and would otherwise remain stuck for the rest of the
      page, painting over every later section that lacks its own
      `position: relative`. `isolate` bounds that entire sticky/z-index
      interaction to just these two sections, so nothing after this div
      needs to know or care that Hero is sticky underneath it.
    -->
    <Hero />
    <HeroDuplicate />
  </div>
  <div class="relative isolate">
    <!--
      This band's own sticky range spans GapDiagram, FourProblems, AND
      DiagnosticTeaser (not just its immediate section) — it's the first
      child of THIS wrapper, so it stays pinned for the combined height of
      all three, releasing only once the wrapper itself has scrolled past,
      right as ThreeLenses' own "HOW WE OPERATE" band begins.
    -->
    <div class="sticky top-0 z-40 flex h-12 items-center bg-blue/50">
      <div class="mx-auto w-full max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
        <p class="text-base font-bold text-white">HOW WE HELP</p>
      </div>
    </div>
    <GapDiagram client:visible={{ rootMargin: '600px' }} />
    <FourProblems />
    <DiagnosticTeaser />
  </div>
  <div class="relative isolate">
    <!--
      This band's own sticky range spans both ThreeLenses and PdeosWheel
      (not just its immediate section) — it's the first child of THIS
      wrapper, so it stays pinned for the combined height of both,
      releasing only once the wrapper itself has scrolled past, right as
      Perspectives' own "WHAT WE PROMISE" band begins.
    -->
    <div class="sticky top-0 z-40 flex h-12 items-center bg-green/50">
      <div class="mx-auto w-full max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
        <p class="text-base font-bold text-white">HOW WE OPERATE</p>
      </div>
    </div>
    <ThreeLenses />
    <PdeosWheel client:visible />
  </div>
  <div class="relative isolate">
    <!--
      This band's own sticky range spans both Perspectives and
      InsightsTeaser (not just its immediate section) — it's the first
      child of THIS wrapper, so it stays pinned for the combined height of
      both, releasing only once the wrapper itself has scrolled past,
      right as FinalCta begins.
    -->
    <div class="sticky top-0 z-40 flex h-12 items-center bg-yellow/50">
      <div class="mx-auto w-full max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
        <p class="text-base font-bold text-navy">WHAT WE PROMISE</p>
      </div>
    </div>
    <Perspectives />
    <InsightsTeaser />
  </div>
  <FinalCta />
  <Footer />
</Layout>
