---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import HeroDuplicate from '../components/HeroDuplicate.astro';
import GapDiagram from '../components/GapDiagram.tsx';
import FourProblems from '../components/FourProblems.astro';
import ThreeLenses from '../components/ThreeLenses.astro';
import DiagnosticTeaser from '../components/DiagnosticTeaser.astro';
import PdeosWheel from '../components/PdeosWheel.tsx';
import Perspectives from '../components/Perspectives.astro';
import InsightsTeaser from '../components/InsightsTeaser.astro';
import AboutTeaser from '../components/AboutTeaser.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Coherenz — Delivery is an investment. Treat it like one."
  description="Coherenz helps product organizations make better investment, prioritization and delivery decisions—turning delivery capacity into measurable business value."
>
  <Nav />
  <Hero />
  <HeroDuplicate />
  <GapDiagram client:visible />
  <FourProblems />
  <ThreeLenses />
  <DiagnosticTeaser />
  <PdeosWheel client:visible />
  <Perspectives />
  <InsightsTeaser />
  <AboutTeaser />
  <FinalCta />
  <Footer />
</Layout>
