---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import HeroDuplicate from '../components/HeroDuplicate.astro';
import GapDiagram from '../components/GapDiagram.tsx';
import FourProblems from '../components/FourProblems.astro';
import ThreeLenses from '../components/ThreeLenses.astro';
import DiagnosticTeaser from '../components/DiagnosticTeaser.astro';
import PdeosWheel from '../components/PdeosWheel.tsx';
import PdeosOrbitalComparison from '../components/PdeosOrbitalComparison.tsx';
import Perspectives from '../components/Perspectives.astro';
import InsightsTeaser from '../components/InsightsTeaser.astro';
import AboutTeaser from '../components/AboutTeaser.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Coherenz — Delivery is an investment. Treat it like one."
  description="Coherenz helps product organizations make better investment, prioritization and delivery decisions—turning delivery capacity into measurable business value."
>
  <Nav />
  <div class="relative isolate">
    <!--
      Hero is `position: sticky`, which stays "stuck" for as long as its
      containing block (this div) is being scrolled through — not just its
      own height — and would otherwise remain stuck for the rest of the
      page, painting over every later section that lacks its own
      `position: relative`. `isolate` bounds that entire sticky/z-index
      interaction to just these two sections, so nothing after this div
      needs to know or care that Hero is sticky underneath it.
    -->
    <Hero />
    <HeroDuplicate />
  </div>
  <GapDiagram client:visible={{ rootMargin: '600px' }} />
  <FourProblems />
  <DiagnosticTeaser />
  <ThreeLenses />
  <PdeosWheel client:visible />
  <section class="bg-wash-blue py-10">
    <p class="mx-auto max-w-[1536px] px-6 pb-4 text-center text-xs font-bold uppercase tracking-[0.25em] text-navy/50 sm:px-8 lg:px-10 xl:px-14">
      Comparison build — not final — same 7 stages, alternate layout
    </p>
    <PdeosOrbitalComparison client:visible />
  </section>
  <Perspectives />
  <InsightsTeaser />
  <AboutTeaser />
  <FinalCta />
  <Footer />
</Layout>
