---
// Per-service detail page -- the forward-linked destination each service
// strip's CTA on /services already points to (`/services/${slug}`), built
// as one dynamic template rather than four hand-written pages since all
// four services share the same data shape (servicesContent.ts). Static
// output (GitHub Pages), so every slug is pre-rendered via getStaticPaths.
//
// Body copy (question, description, pill titles/descriptions, closing
// line) is exactly the existing approved content from servicesContent.ts
// -- nothing new invented there. The section headings, back-link and
// cross-sell framing on this page ARE new drafted copy (this page isn't
// covered by Site Context.docx), so treat those as first-pass draft text
// pending Jon's review, not final.
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import FinalCta from '../../components/FinalCta.astro';
import { BlurReveal } from '../../components/ui/blur-reveal.tsx';
import { GlowingEffect } from '../../components/ui/glowing-effect.tsx';
import { ChallengeCard } from '../../components/ui/card-21';
import { base } from '../../lib/base';
import { services, type ServiceDefinition } from '../../data/servicesContent';
import {
  IconCompass,
  IconCalculator,
  IconShieldCheck,
  IconHierarchy3,
  IconArrowLeft,
  IconTarget,
  IconListNumbers,
  IconScale,
  IconRoute,
  IconCoin,
  IconHourglass,
  IconGavel,
  IconReportAnalytics,
  IconAdjustmentsHorizontal,
  IconChartLine,
  IconGauge,
  IconStopwatch,
  IconCircleCheck,
  IconAffiliate,
  IconFilter,
  IconStethoscope,
  IconTrendingUp,
  IconLink,
  IconChartBar,
  IconRefresh,
  IconEye,
  IconSitemap,
  IconUserCheck,
  IconUsersGroup,
  IconKey,
  IconBriefcase,
  IconUserStar,
} from '@tabler/icons-react';

const icons = {
  compass: IconCompass,
  calculator: IconCalculator,
  'shield-check': IconShieldCheck,
  hierarchy: IconHierarchy3,
} as const;

// One distinct icon per pill (servicesContent.ts's ServicePill.icon) --
// every pill used to fall back to the service's own single icon, which
// meant all 7-8 capability cards on a given service page looked identical.
const pillIcons = {
  target: IconTarget,
  'list-numbers': IconListNumbers,
  scale: IconScale,
  route: IconRoute,
  coin: IconCoin,
  hourglass: IconHourglass,
  gavel: IconGavel,
  'report-analytics': IconReportAnalytics,
  'adjustments-horizontal': IconAdjustmentsHorizontal,
  'chart-line': IconChartLine,
  gauge: IconGauge,
  stopwatch: IconStopwatch,
  'circle-check': IconCircleCheck,
  affiliate: IconAffiliate,
  filter: IconFilter,
  stethoscope: IconStethoscope,
  'trending-up': IconTrendingUp,
  link: IconLink,
  'chart-bar': IconChartBar,
  'shield-check': IconShieldCheck,
  refresh: IconRefresh,
  eye: IconEye,
  sitemap: IconSitemap,
  'user-check': IconUserCheck,
  'users-group': IconUsersGroup,
  key: IconKey,
  briefcase: IconBriefcase,
  'user-star': IconUserStar,
} as const;

// Same four-accent rotation as the services page's ServiceSelector strips,
// keyed by position so each service keeps the same accent color here as it
// has there. Inlined into getStaticPaths (rather than referenced from a
// shared const) because Astro hoists getStaticPaths to module scope
// separately from the rest of the frontmatter -- it can't see consts
// declared alongside it here, only its own closure and top-level imports.
type StripAccent = 'blue' | 'orange' | 'green' | 'navy';

export function getStaticPaths() {
  const stripAccents: StripAccent[] = ['blue', 'orange', 'green', 'navy'];
  return services.map((service, i) => ({
    params: { slug: service.slug },
    props: { service, accent: stripAccents[i % stripAccents.length] },
  }));
}

interface Props {
  service: ServiceDefinition;
  accent: StripAccent;
}

const { service, accent } = Astro.props;
const Icon = icons[service.iconName];
const otherServices = services.filter((s) => s.slug !== service.slug);

const accentText: Record<StripAccent, string> = {
  blue: 'text-blue',
  orange: 'text-orange',
  green: 'text-green',
  navy: 'text-navy',
};
const accentBg: Record<StripAccent, string> = {
  blue: 'bg-blue/10',
  orange: 'bg-orange/10',
  green: 'bg-green/10',
  navy: 'bg-navy/10',
};

// Same HSL-triplet values as FourProblems.astro/insights.astro's
// "From Insight to Action" ChallengeCards -- keyed by slug (not position)
// so each service keeps the one theme color it's known by everywhere else
// on the site, regardless of which 3 "other services" end up in this grid.
const otherServiceThemeColors: Record<string, string> = {
  'product-portfolio-strategy': '36 80% 55%',
  'product-delivery-economics': '212 44% 32%',
  'delivery-stabilization': '47 100% 35%',
  'product-operating-model': '165 55% 20%',
};
const otherServiceCardItems = otherServices.map((other) => ({
  imageUrl: `${base}img/problems/${other.slug}.jpg`,
  headline: other.name,
  label: other.question,
  desc: other.description,
  href: `${base}services/${other.slug}`,
  themeColor: otherServiceThemeColors[other.slug],
  leftAlignText: true,
  splitLayout: true,
  framedImage: true,
  swapLabelCta: true,
  compactHeadline: true,
  ctaLabel: other.ctaText,
}));
---

<Layout title={`${service.name} — Coherenz`} description={service.description}>
  <Nav />

  <section class="relative flex min-h-[60vh] items-end overflow-hidden bg-navy">
    <img src={`${base}img/problems/${service.slug}.jpg`} alt="" class="absolute inset-0 h-full w-full object-cover object-top" />
    <div class="absolute inset-0 bg-gradient-to-t from-navy via-navy/80 to-navy/40" />
    <div class="relative mx-auto w-full max-w-[1536px] px-6 py-20 sm:px-8 lg:px-10 xl:px-14">
      <BlurReveal client:visible delay={0} className="block">
        <a href={`${base}services`} class="inline-flex items-center gap-2 text-sm font-bold text-white/80 hover:text-white">
          <IconArrowLeft size={16} stroke={2} />
          All Services
        </a>
      </BlurReveal>
      <BlurReveal client:visible delay={0.1} className="block">
        <p class="mt-5 text-sm font-bold uppercase tracking-[0.375em] text-orange">{service.name}</p>
      </BlurReveal>
      <BlurReveal client:visible delay={0.2} className="block">
        <h1 class="mt-3 max-w-2xl font-serif text-4xl text-white sm:text-5xl">{service.question}</h1>
      </BlurReveal>
      <BlurReveal client:visible delay={0.3} className="block">
        <p class="mt-4 max-w-xl text-white/80">{service.description}</p>
      </BlurReveal>
      <BlurReveal client:visible delay={0.4} className="block">
        <a
          href={`${base}contact`}
          class="mt-7 inline-block rounded-full bg-primary px-6 py-3 text-sm font-bold text-primary-foreground"
        >
          Talk to Coherenz →
        </a>
      </BlurReveal>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <div class="hero-float-left">
        <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">Where Coherenz Focuses</p>
        <h2 class="mt-3 max-w-2xl font-serif text-4xl text-navy sm:text-5xl">What This Work Covers</h2>
        <p class="mt-4 max-w-2xl text-foreground/70">
          Every engagement is scoped to the areas most relevant to your organization, drawn from the following.
        </p>
      </div>

      <div class="mt-[50px] grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal-grid>
        {service.pills.map((pill, i) => {
          const PillIcon = pillIcons[pill.icon];
          return (
            <div
              class="relative border border-line bg-white p-8"
              data-reveal-item
              style={`transition-delay: ${i * 150}ms`}
            >
              <GlowingEffect client:visible glow disabled={false} spread={40} proximity={64} inactiveZone={0.01} borderWidth={2} />
              <span class={`relative flex h-12 w-12 items-center justify-center rounded-full ${accentBg[accent]} ${accentText[accent]}`}>
                <PillIcon size={24} stroke={1.8} />
              </span>
              <h3 class="relative mt-5 font-serif text-2xl text-navy">{pill.title}</h3>
              <p class="relative mt-3 text-sm text-foreground/70">{pill.description}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  {/* min-h matches "Explore the Other Services" below (545px, measured
      consistent across services since that section's shape -- heading + 3
      fixed-format cards -- doesn't vary) so this quote doesn't read as a
      throwaway sliver next to it. grid items-center (not flex) keeps the
      centered text block at its normal full-width block sizing instead of
      a flex row's shrink-to-fit default -- same reasoning as FinalCta's
      minHeightClass and CoherenzPerspective's min-height. */}
  <section class="grid min-h-[545px] items-center bg-navy py-16 sm:py-24">
    <div class="perspective-float relative mx-auto max-w-[1536px] px-6 text-center sm:px-8 lg:px-10 xl:px-14">
      <p class="mx-auto max-w-3xl font-serif text-3xl text-white sm:text-4xl">{service.closing}</p>
    </div>
  </section>

  <section class="bg-cream py-16 sm:py-24">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <div class="hero-float-left">
        <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">Related</p>
        <h2 class="mt-3 max-w-2xl font-serif text-4xl text-navy sm:text-5xl">Explore the Other Services</h2>
      </div>

      <div class="mt-[60px] grid grid-cols-1 gap-6 sm:grid-cols-3" data-reveal-grid>
        {otherServiceCardItems.map((item, i) => {
          return (
            <div class="h-[384px]" data-reveal-item style={`transition-delay: ${i * 150}ms`}>
              <ChallengeCard {...item} />
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <FinalCta
    eyebrow="Find the Leakage"
    body="Whether the challenge is investment, delivery, capacity or organizational scale, Coherenz helps identify what is getting in the way—and where to focus first."
    ctaText="Start a Conversation →"
    secondaryCtaText="Explore Coherenz Insights →"
    secondaryCtaHref={`${base}insights`}
  >
    <Fragment slot="headline">Better Decisions Start With Seeing the System Clearly.</Fragment>
  </FinalCta>
  <Footer />
</Layout>

<style>
  /* Same reveal-on-scroll vocabulary used across the rest of the site
     (about.astro, insights.astro, FourProblems.astro, CoherenzPerspective.
     astro, etc.) -- this page previously had none of it beyond the hero's
     BlurReveal, so "What This Work Covers", the closing quote, and
     "Explore the Other Services" all appeared instantly with no motion. */
  .hero-float-left {
    opacity: 0;
    transform: translateX(-28px);
    transition:
      opacity 1500ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 1500ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .hero-float-left.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  /* Same treatment as CoherenzPerspective.astro's centered quote -- fade
     up rather than in-from-the-side, since this reads as one self-
     contained statement, not a left-anchored section intro. */
  .perspective-float {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 1500ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 1500ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .perspective-float.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  [data-reveal-item] {
    --reveal-duration: 1500ms;
    opacity: 0;
    transform: translateX(-28px);
    transition:
      opacity var(--reveal-duration) cubic-bezier(0.23, 1, 0.32, 1),
      transform var(--reveal-duration) cubic-bezier(0.23, 1, 0.32, 1);
  }

  [data-reveal-item].is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-float-left,
    .perspective-float,
    [data-reveal-item] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initHeroFloatLeft() {
    document.querySelectorAll<HTMLElement>('.hero-float-left').forEach((el) => {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          el.classList.add('is-visible');
          io.disconnect();
        },
        { threshold: 0.2 }
      );
      io.observe(el);
    });
  }

  function initPerspectiveFloat() {
    document.querySelectorAll<HTMLElement>('.perspective-float').forEach((el) => {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          el.classList.add('is-visible');
          io.disconnect();
        },
        { threshold: 0.2 }
      );
      io.observe(el);
    });
  }

  function initRevealGrids() {
    document.querySelectorAll<HTMLElement>('[data-reveal-grid]').forEach((grid) => {
      const items = grid.querySelectorAll<HTMLElement>('[data-reveal-item]');
      if (!items.length) return;
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          items.forEach((el) => el.classList.add('is-visible'));
          io.disconnect();
        },
        { threshold: 0.2 }
      );
      io.observe(grid);
    });
  }

  function init() {
    initHeroFloatLeft();
    initPerspectiveFloat();
    initRevealGrids();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
