---
// Insights page, rebuilt per "insights page flow.docx" (assets/insights
// page/) -- a developer-handoff spec for editorial page structure and
// copy. Section order, headlines, and card copy below follow that doc
// directly: INSIGHTS HERO → FEATURED INSIGHT → INSIGHT COLLECTION INTRO →
// VALUE & INVESTMENT → CAPACITY & FLOW → COHERENZ PERSPECTIVE →
// SYSTEM DESIGN → FROM INSIGHT TO ACTION → FOOTER. Per the doc's Design
// Principles (§13: "Question-led, not category-led" / avoid "excessive
// category tags"), the old flat card grid + 4-theme filter-info section
// from the previous structural pass are gone -- the three named editorial
// sections now carry that organizing role instead.
//
// The three sections' 9 cards keep real photography where it already
// exists (the same three images the homepage teaser uses); the other six
// topics have no photography yet, so they render a themed placeholder
// panel rather than borrowing unrelated site imagery or fabricating a
// stock photo -- swap in real photos when Jon supplies them. Long-form
// article content itself is still out of scope here -- each full article
// should go through the deep-research → fact-checker → technical-writer
// pipeline (see project memory) rather than being drafted freehand, and
// none of these cards link anywhere real yet since no article pages exist.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import InsightGridCard from '../components/InsightGridCard.astro';
import { ChallengeCard } from '../components/ui/card-21.tsx';
import { BlurReveal } from '../components/ui/blur-reveal.tsx';
import { base } from '../lib/base';
import {
  topInsight,
  insightsHero,
  insightCollectionIntro,
  insightSections,
  perspectiveBreak,
  fromInsightToAction,
} from '../data/insightsContent';
import { programs as servicePrograms } from '../data/servicesContent';
import { IconReportMoney, IconActivity, IconRefresh, IconArrowUpRight } from '@tabler/icons-react';

// Same ChallengeCard (card-21) + program photography/theme colors used by
// services.astro's "Ways to Work Together" grid, per Jon's call to make
// this section consistent with it. fromInsightToAction only surfaces the
// first three of servicesContent's four programs (no Executive Workshop
// here), so this reuses that same data/image/color pairing sliced to
// three -- not a second, separately maintained copy of the program copy.
// Links stay on the dedicated /programs/[slug] route (more precise than
// services.astro's /programs#anchor pattern) rather than copying that too.
const actionProgramImages = ['programs/diagnostic.jpg', 'programs/stabilization.jpg', 'programs/operating-model.jpg'];
const actionProgramThemeColors = ['36 80% 55%', '212 44% 32%', '47 100% 35%'];
const actionProgramCardItems = fromInsightToAction.programs.map(({ slug, ctaLabel }, i) => ({
  imageUrl: `${base}img/${actionProgramImages[i]}`,
  headline: servicePrograms[i].name,
  label: servicePrograms[i].tagline,
  desc: servicePrograms[i].description,
  href: `${base}programs/${slug}`,
  themeColor: actionProgramThemeColors[i],
  leftAlignText: true,
  splitLayout: true,
  framedImage: true,
  swapLabelCta: true,
  compactHeadline: true,
  ctaLabel,
}));

// One representative icon per editorial section, used for that section's
// image-less placeholder cards.
const sectionIcons = [IconReportMoney, IconActivity, IconRefresh];
---

<Layout
  title="Insights — Coherenz"
  description="Better questions about how product organizations create value. Perspectives on product strategy, delivery economics, capacity, flow, and the decisions that shape business outcomes."
>
  <Nav />

  <section id="insights-hero" class="relative flex min-h-[70vh] items-end overflow-hidden bg-navy">
    <video id="insights-hero-video" class="absolute inset-0 h-full w-full object-cover" autoplay muted loop playsinline>
      <source src={`${base}video/insights-hero-2.mp4`} type="video/mp4" />
    </video>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy via-navy/70 to-navy/20" />
    <div class="relative mx-auto w-full max-w-[1536px] px-6 py-20 sm:px-8 lg:px-10 xl:px-14">
      <BlurReveal client:visible delay={0} className="block">
        <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">{insightsHero.eyebrow}</p>
      </BlurReveal>
      <BlurReveal client:visible delay={0.1} className="block">
        <h1 class="mt-3 max-w-2xl font-serif text-4xl text-white sm:text-5xl">{insightsHero.headline}</h1>
      </BlurReveal>
      <BlurReveal client:visible delay={0.2} className="block">
        <p class="mt-4 max-w-2xl text-white/75">{insightsHero.supporting}</p>
      </BlurReveal>
    </div>
  </section>

  <section id="featured-insight" class="bg-wash-green py-16 sm:py-24">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <a href={`${base}insights/${topInsight.slug}`} class="group grid cursor-pointer grid-cols-1 border border-line md:grid-cols-2 md:h-[563px]">
        <div class="flex flex-col justify-start overflow-y-auto bg-white p-6 sm:p-8">
          <p class="text-xs font-bold uppercase tracking-wide text-orange">{topInsight.tag}</p>
          <h3 class="mt-2 font-serif text-3xl text-navy sm:text-4xl">{topInsight.title}</h3>
          <p class="mt-2 font-medium text-navy/80">{topInsight.subhead}</p>
          <p class="mt-2 text-sm text-foreground/70">{topInsight.body}</p>
          <p class="mt-4 inline-flex items-center gap-2 font-bold text-orange">
            <IconArrowUpRight
              size={20}
              stroke={2}
              class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            />
            Read the Insight
          </p>
        </div>
        <div class="min-h-[240px] overflow-hidden md:h-full">
          <img
            src={`${base}img/photography/${topInsight.image}`}
            alt={topInsight.imageAlt}
            class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
          />
        </div>
      </a>
    </div>
  </section>

  <section id="insight-collection-intro" class="bg-white pt-16 sm:pt-24">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">Coherenz Thinking</p>
      <h2 class="float-up mt-3 max-w-2xl font-serif text-4xl text-navy sm:text-5xl">{insightCollectionIntro.headline}</h2>
      <p class="mt-4 max-w-2xl text-foreground/70">{insightCollectionIntro.supporting}</p>
    </div>
  </section>

  {insightSections.slice(0, 2).map(({ name, items }, i) => (
    <section class="bg-white py-16 sm:py-20">
      <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
        <h3 class="float-up font-serif text-2xl text-navy sm:text-3xl">{name}</h3>
        <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((item) => (
            <InsightGridCard {...item} Icon={sectionIcons[i]} />
          ))}
        </div>
      </div>
    </section>
  ))}

  <section id="perspective-break" class="relative overflow-hidden bg-navy py-20 sm:py-32">
    <img
      src={`${base}img/monogram.svg`}
      alt=""
      class="pointer-events-none absolute -right-10 -top-16 w-72 opacity-[0.18] sm:-right-6 sm:-top-20 sm:w-96"
    />
    <div class="float-up relative mx-auto max-w-3xl px-6 text-center sm:px-8">
      <div class="mx-auto mb-8 h-px w-16 bg-orange" aria-hidden="true" />
      <p class="font-serif text-[28px] text-white sm:text-[36px]">{perspectiveBreak.statement}</p>
      <p class="mt-5 text-white/70">{perspectiveBreak.body}</p>
    </div>
  </section>

  {insightSections.slice(2).map(({ name, items }, i) => (
    <section class="bg-white py-16 sm:py-24">
      <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
        <h3 class="float-up font-serif text-2xl text-navy sm:text-3xl">{name}</h3>
        <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((item) => (
            <InsightGridCard {...item} Icon={sectionIcons[i + 2]} />
          ))}
        </div>
      </div>
    </section>
  ))}

  <section id="insight-to-action" class="bg-wash-blue py-16 sm:py-24">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">{fromInsightToAction.eyebrow}</p>
      <h2 class="float-up mt-3 max-w-2xl font-serif text-4xl text-navy sm:text-5xl">{fromInsightToAction.headline}</h2>
      <p class="mt-4 max-w-2xl text-foreground/70">{fromInsightToAction.supporting}</p>

      <div class="mt-[60px] grid grid-cols-1 gap-6 sm:grid-cols-3">
        {actionProgramCardItems.map((item) => (
          <div class="h-[384px]">
            <ChallengeCard {...item} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  // Same off-screen pause pattern as the other hero videos on this site --
  // a looping autoplay video keeps decoding/buffering frames indefinitely
  // even while scrolled far out of view.
  function initInsightsHeroVideoPause() {
    const section = document.getElementById('insights-hero');
    const video = document.getElementById('insights-hero-video') as HTMLVideoElement | null;
    if (!section || !video) return;

    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) video.play().catch(() => {});
        else video.pause();
      },
      { threshold: 0 }
    );
    io.observe(section);
  }

  initInsightsHeroVideoPause();
  document.addEventListener('astro:page-load', initInsightsHeroVideoPause);
</script>

<style>
  /* Float-in from the bottom, same character used across the /insights
     article template (InsightHeader.astro's hero, CoherenzPerspective.astro,
     ActionAndClosing.astro): 28px travel, 1500ms, strong ease-out. Each
     marked element is its own independent unit, so each gets its own
     IntersectionObserver -- the hero fires immediately since it's already
     in view on load, everything else fires as the reader scrolls to it. */
  .float-up {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 1500ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 1500ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .float-up.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .float-up {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* Hero content floats in from the left instead of up from the bottom --
     same 1500ms strong ease-out, just horizontal, per Jon's call for this
     one element only. Kept as its own class rather than a modifier on
     .float-up so the other five float-up elements on this page are untouched. */
  .hero-float-left {
    opacity: 0;
    transform: translateX(-28px);
    transition:
      opacity 1500ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 1500ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .hero-float-left.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-float-left {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initFloatReveal() {
    document.querySelectorAll<HTMLElement>('.float-up, .hero-float-left').forEach((el) => {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          el.classList.add('is-visible');
          io.disconnect();
        },
        { threshold: 0.2 }
      );
      io.observe(el);
    });
  }

  initFloatReveal();
  document.addEventListener('astro:page-load', initFloatReveal);
</script>
