---
// Insights ("Coherenz Thinking") index page. Structure and the four theme
// categories are ported from "Site Context.docx" §6 (Insights) -- "This
// should be a significant part of the website—not just a blog... Organize
// it into four themes" -- theme names and their sub-topic lists are the
// doc's own wording, not invented. Content (featured piece + 3-card grid)
// reuses the same real, Jon-supplied copy/photos already live in
// InsightsTeaser.astro, via the shared src/data/insightsContent.ts.
//
// Scope note: this is a structural first pass, not final. Per the doc,
// this page is meant to eventually organize "Reports | Frameworks |
// Articles | Case Studies" and grow well past today's four pieces -- each
// full article should go through the deep-research → fact-checker →
// technical-writer pipeline (see project memory) rather than being drafted
// freehand, so none of that long-form writing happens here. The hero also
// intentionally has no background video yet (every other interior page's
// video took several rounds of picking before landing on-brand) -- flagging
// that rather than guessing one in, per CLAUDE.md's "flag off-brand or
// placeholder content" rule.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FinalCta from '../components/FinalCta.astro';
import { base } from '../lib/base';
import { topInsight, insights, insightThemes } from '../data/insightsContent';
import { IconReportMoney, IconActivity, IconCompass, IconRefresh } from '@tabler/icons-react';

const themeIcons = [IconReportMoney, IconActivity, IconCompass, IconRefresh];
---

<Layout
  title="Insights — Coherenz"
  description="Coherenz Thinking: perspectives on product economics, delivery economics, product leadership, and transformation—for leaders making investment, prioritization, and delivery decisions."
>
  <Nav />

  <section id="insights-hero" class="relative flex min-h-[70vh] items-end overflow-hidden bg-navy">
    <video id="insights-hero-video" class="absolute inset-0 h-full w-full object-cover" autoplay muted loop playsinline>
      <source src={`${base}video/insights-hero-2.mp4`} type="video/mp4" />
    </video>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy via-navy/70 to-navy/20" />
    <div class="relative mx-auto w-full max-w-[1536px] px-6 py-20 sm:px-8 lg:px-10 xl:px-14">
      <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">Coherenz Thinking</p>
      <h1 class="mt-3 max-w-2xl font-serif text-4xl text-white sm:text-5xl">Perspectives worth your time.</h1>
      <p class="mt-4 max-w-2xl text-white/75">
        Practical thinking on the economics of product delivery—for leaders making investment, prioritization, and
        delivery decisions.
      </p>
    </div>
  </section>

  <section id="insights-themes" class="bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">Explore by Theme</p>
      <h2 class="mt-3 max-w-2xl font-serif text-4xl text-navy sm:text-5xl">Four lenses on delivery economics.</h2>

      <div class="mt-[60px] grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {insightThemes.map(({ name, topics }, i) => {
          const Icon = themeIcons[i];
          return (
            <div class="border border-line p-6">
              <Icon size={26} strokeWidth={1.8} class="text-orange" />
              <h3 class="mt-4 text-lg font-bold text-navy">{name}</h3>
              <ul class="mt-3 space-y-1.5">
                {topics.map((topic) => (
                  <li class="text-sm text-foreground/70">{topic}</li>
                ))}
              </ul>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <section id="insights-list" class="bg-wash-green py-16 sm:py-24">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">Latest Thinking</p>
      <h2 class="mt-3 max-w-2xl font-serif text-4xl text-navy sm:text-5xl">Start here.</h2>

      <div class="mt-[60px] grid grid-cols-1 border border-line md:grid-cols-2 md:h-[563px]">
        <div class="flex flex-col justify-start overflow-y-auto bg-white p-6 sm:p-8">
          <p class="text-xs font-bold uppercase tracking-wide text-orange">{topInsight.tag}</p>
          <h3 class="mt-2 font-serif text-3xl text-navy sm:text-4xl">{topInsight.title}</h3>
          <p class="mt-2 font-medium text-navy/80">{topInsight.subhead}</p>
          <p class="mt-2 text-sm text-foreground/70">{topInsight.body}</p>
        </div>
        <div class="min-h-[240px] md:h-full">
          <img
            src={`${base}img/photography/${topInsight.image}`}
            alt={topInsight.imageAlt}
            class="h-full w-full object-cover"
          />
        </div>
      </div>

      <div class="mt-[60px] grid grid-cols-1 gap-4 sm:grid-cols-3">
        {insights.map(({ tag, title, description, image, imageAlt }) => (
          <div class="flex h-full flex-col border border-line bg-white">
            <img src={`${base}img/photography/${image}`} alt={imageAlt} class="h-40 w-full object-cover" />
            <div class="flex flex-1 flex-col p-5">
              <p class="text-xs font-bold uppercase tracking-wide text-yellow">{tag}</p>
              <h5 class="mt-2 text-[15px] font-semibold leading-snug text-navy">{title}</h5>
              <p class="mt-2 text-xs text-foreground/70">{description}</p>
            </div>
          </div>
        ))}
      </div>

      <p class="mt-[60px] text-center text-sm text-navy/60">More perspectives are on the way.</p>
    </div>
  </section>

  <div class="relative overflow-hidden bg-navy">
    <img
      src={`${base}img/monogram.svg`}
      alt=""
      class="pointer-events-none absolute -right-6 -top-20 w-96 opacity-[0.22] sm:-right-4 sm:w-[30rem]"
    />
    <FinalCta showPortrait={false} showMonogram={false} transparent />
    <Footer transparent />
  </div>
</Layout>

<script>
  // Same off-screen pause pattern as the other hero videos on this site --
  // a looping autoplay video keeps decoding/buffering frames indefinitely
  // even while scrolled far out of view.
  function initInsightsHeroVideoPause() {
    const section = document.getElementById('insights-hero');
    const video = document.getElementById('insights-hero-video') as HTMLVideoElement | null;
    if (!section || !video) return;

    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) video.play().catch(() => {});
        else video.pause();
      },
      { threshold: 0 }
    );
    io.observe(section);
  }

  initInsightsHeroVideoPause();
  document.addEventListener('astro:page-load', initInsightsHeroVideoPause);
</script>
