---
// Programs page, built from "Coherenz Programs Page - Content Flow.docx"
// (assets/programs page/) -- every section, headline, and body copy below
// follows that doc's structure and wording directly; nothing here is
// drafted content. See src/data/programsContent.ts for the source data.
//
// Per the doc's own "Recommended Relationship Between the Website Pages"
// note: Approach owns how Coherenz thinks, Services owns what challenges
// Coherenz solves, and this page owns focused ways to engage -- so this
// page doesn't re-explain the PDE-OS methodology or re-run the four
// service questions, it stays scoped to the four programs themselves.
//
// Each program CTA links to a dedicated detail page (`/programs/[slug]`)
// that doesn't exist yet -- same forward-linking pattern already used for
// `/services/[slug]` elsewhere in this rebuild. Building those detail
// pages is separate follow-up work.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FinalCta from '../components/FinalCta.astro';
import InsightsTeaser from '../components/InsightsTeaser.astro';
import { base } from '../lib/base';
import { programs, programMatches, programWorksSteps } from '../data/programsContent';
import {
  IconSearch,
  IconShieldCheck,
  IconHierarchy3,
  IconPresentation,
  IconCircleCheckFilled,
  IconArrowRight,
  IconEye,
  IconFocus2,
  IconRocket,
  IconRoute,
} from '@tabler/icons-react';

const programIcons = [IconSearch, IconShieldCheck, IconHierarchy3, IconPresentation];
const programImages = ['diagnostic.jpg', 'stabilization.jpg', 'operating-model.jpg', 'executive-workshop.jpg'];
const programWorksIcons = [IconEye, IconFocus2, IconRocket, IconRoute];

// Same four brand hues already established for these exact four programs
// on the Services page's teaser cards (FourProblems/ChallengeCard usage) --
// reused here rather than introducing new colors, per DESIGN.md's locked
// 6-color palette.
const programAccents = [
  { border: 'border-t-orange', text: 'text-orange', iconBg: 'bg-orange/10' },
  { border: 'border-t-blue', text: 'text-blue', iconBg: 'bg-blue/10' },
  { border: 'border-t-green', text: 'text-green', iconBg: 'bg-green/10' },
  { border: 'border-t-navy', text: 'text-navy', iconBg: 'bg-navy/10' },
];

function programHref(slug: string) {
  return `${base}programs/${slug}`;
}
---

<Layout
  title="Programs — Coherenz"
  description="Focused programs for the challenges that can't wait. Coherenz Programs provide a clear starting point to diagnose a problem, create clarity, and move toward action."
>
  <Nav />

  <section id="programs-hero" class="relative flex min-h-[70vh] items-end overflow-hidden bg-navy">
    <video id="programs-hero-video" class="absolute inset-0 h-full w-full object-cover" autoplay muted loop playsinline>
      <source src={`${base}video/programs-hero.mp4`} type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-gradient-to-t from-navy via-navy/70 to-navy/20" />
    <div class="relative mx-auto w-full max-w-[1536px] px-6 py-20 sm:px-8 lg:px-10 xl:px-14">
      <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">Coherenz Programs</p>
      <h1 class="mt-3 max-w-2xl font-serif text-4xl text-white sm:text-5xl">
        Focused programs for the challenges that can't wait.
      </h1>
      <p class="mt-4 max-w-xl text-white/75">
        When you know something needs to change—but don't need another open-ended consulting engagement—Coherenz
        Programs provide a focused way to diagnose the problem, create clarity, and move toward action.
      </p>
      <p class="mt-2 max-w-xl text-white/75">
        Each program is structured around a specific challenge, with a clear objective and practical outcome.
      </p>
      <a href="#programs" class="mt-7 inline-block rounded-full bg-primary px-6 py-3 text-sm font-bold text-primary-foreground">
        Explore the Programs ↓
      </a>
    </div>
  </section>

  <section class="flex min-h-screen flex-col justify-center bg-navy py-16">
    <div class="mx-auto max-w-[1536px] px-6 text-center sm:px-8 lg:px-10 xl:px-14">
      <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">A Clear Place to Start</p>
      <h2 class="mx-auto mt-3 max-w-2xl font-serif text-4xl text-white sm:text-5xl">
        Not every challenge needs a long transformation program.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/70">
        Some situations require a focused intervention: a clearer picture of where delivery capacity is being
        lost, a way to stabilize an organization under pressure, or a decision about how the product organization
        should operate as it grows.
      </p>
      <p class="mx-auto mt-3 max-w-2xl text-white/70">
        Coherenz Programs are designed to create meaningful progress around a specific challenge—without starting
        with a large, undefined engagement.
      </p>
    </div>
  </section>

  <section id="programs" class="bg-navy py-16 sm:py-24">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <div id="programs-intro-reveal">
        <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">The Four Programs</p>
        <h2 class="mt-3 max-w-2xl font-serif text-4xl text-white sm:text-5xl">
          Focused engagements. Clear outcomes. Practical momentum.
        </h2>
      </div>
    </div>
  </section>

  {programs.map((program, i) => {
    const Icon = programIcons[i];
    const a = programAccents[i];
    return (
      <section id={program.slug} class="flex min-h-screen flex-col justify-center bg-navy py-16" data-program-section>
        <div class="mx-auto w-full max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
          <div class="grid grid-cols-1 lg:grid-cols-2">
            <div class="flex h-full flex-col border border-line border-t-4 border-t-orange bg-white p-8 sm:p-12" data-program-card>
              <div class="flex items-center justify-between">
                <p class={`text-xs font-bold uppercase tracking-wide ${a.text}`}>
                  {program.number} — {program.category}
                </p>
                <span class={`flex h-11 w-11 shrink-0 items-center justify-center rounded-full ${a.iconBg} ${a.text}`}>
                  <Icon size={22} stroke={1.8} />
                </span>
              </div>
              <h3 class="mt-4 font-serif text-2xl text-navy sm:text-3xl">{program.name}</h3>
              <p class="mt-2 text-lg font-semibold text-navy">{program.promise}</p>
              <p class="mt-3 text-sm text-foreground/70">{program.description}</p>

              <p class="mt-4 text-xs font-bold uppercase tracking-wide text-foreground/50">You will gain</p>
              <ul class="mt-2 space-y-2">
                {program.gains.map((gain) => (
                  <li class="flex items-start gap-2 text-sm text-foreground/70">
                    <IconCircleCheckFilled size={16} class={`mt-0.5 shrink-0 ${a.text}`} />
                    {gain}
                  </li>
                ))}
              </ul>

              <a href={programHref(program.slug)} class={`mt-auto inline-flex items-center gap-2 pt-5 text-sm font-bold ${a.text}`}>
                {program.ctaText}
                <IconArrowRight size={16} stroke={2} />
              </a>
            </div>

            <div class="relative hidden overflow-hidden border border-line border-t-4 border-t-orange lg:block" data-program-image>
              <img src={`${base}img/programs/${programImages[i]}`} alt="" class="h-full w-full object-cover" />
              {/* Corner-bracket frame lifted from ElegantCarousel (homepage
                  Perspectives section) -- same size/position/opacity, tinted
                  with this program's own accent instead of a per-slide color. */}
              <div class={`pointer-events-none absolute left-5 top-5 h-10 w-10 border-l-2 border-t-2 opacity-80 ${a.text.replace('text-', 'border-')}`} />
              <div class={`pointer-events-none absolute bottom-5 right-5 h-10 w-10 border-b-2 border-r-2 opacity-80 ${a.text.replace('text-', 'border-')}`} />
              <div class="absolute inset-x-8 top-1/2 -translate-y-1/2 border border-white/20 bg-navy/25 p-6 text-white backdrop-blur-md">
                <p class="text-[14px] font-bold uppercase tracking-wide text-orange">Best for organizations asking</p>
                <p class="mt-2 text-[16px] italic text-white/85">"{program.bestForQuestion}"</p>
              </div>
            </div>
          </div>
        </div>
      </section>
    );
  })}

  <section class="bg-navy py-16 sm:py-24">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">Find Your Starting Point</p>
      <h2 class="mt-3 max-w-2xl font-serif text-4xl text-white sm:text-5xl">What does your organization need right now?</h2>

      <div class="mt-[50px] grid grid-cols-1 gap-4 sm:grid-cols-2">
        {programMatches.map((match) => {
          const program = programs.find((p) => p.slug === match.programSlug)!;
          return (
            <a
              href={programHref(match.programSlug)}
              class="group flex items-center justify-between gap-4 border border-orange bg-wash-blue p-6 transition-colors hover:border-orange"
            >
              <div>
                <p class="text-navy">{match.need}</p>
                <p class="mt-2 text-sm font-bold text-blue">{program.name}</p>
              </div>
              <IconArrowRight size={20} stroke={2} class="shrink-0 text-blue transition-transform group-hover:translate-x-1" />
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="relative flex min-h-[774px] flex-col justify-center overflow-hidden bg-navy py-16 text-white sm:py-24">
    <img src={`${base}img/coherenz-view-bg.jpg`} alt="" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-b from-navy to-navy/30" />
    <div class="relative mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <h2 class="max-w-2xl font-serif text-4xl text-white sm:text-5xl">Focused by design. Practical in execution.</h2>

      <div class="mt-[50px] flex flex-col gap-3 lg:flex-row lg:items-stretch lg:gap-0">
        {programWorksSteps.map((step, i) => {
          const StepIcon = programWorksIcons[i];
          return (
            <Fragment>
              {i > 0 && (
                <div class="hidden shrink-0 items-center justify-center px-4 text-white/30 lg:flex" aria-hidden="true">
                  →
                </div>
              )}
              <div class="flex flex-1 flex-col gap-3 border border-white/15 bg-white/5 p-5">
                <span class="flex h-10 w-10 items-center justify-center rounded-full border border-orange/40 text-orange">
                  <StepIcon size={20} stroke={1.8} />
                </span>
                <p class="text-xs font-bold uppercase tracking-wide text-orange">{step.number} — {step.name}</p>
                <p class="text-sm text-white/70">{step.description}</p>
              </div>
            </Fragment>
          );
        })}
      </div>
    </div>
  </section>

  <InsightsTeaser />
  <div class="relative overflow-hidden bg-navy">
    <img
      src={`${base}img/monogram.svg`}
      alt=""
      class="pointer-events-none absolute -right-6 -top-20 w-96 opacity-[0.22] sm:-right-4 sm:w-[30rem]"
    />
    <FinalCta
      showPortrait={false}
      showMonogram={false}
      transparent
      eyebrow="Not Sure Where to Start?"
      body="You don't need to know exactly what engagement you need. If you can describe what's happening in your product or delivery organization, we can help identify the right place to begin."
      ctaText="Talk to Coherenz →"
      ctaHref={`${base}contact`}
      secondaryCtaText="Explore Our Services →"
      secondaryCtaHref={`${base}services`}
    >
      <Fragment slot="headline">Start with the problem—not the program.</Fragment>
    </FinalCta>
    <Footer transparent />
  </div>
</Layout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Same off-screen pause pattern as the other hero videos on this site --
  // a looping autoplay video keeps decoding/buffering frames indefinitely
  // even while scrolled far out of view.
  function initProgramsHeroVideoPause() {
    const section = document.getElementById('programs-hero');
    const video = document.getElementById('programs-hero-video') as HTMLVideoElement | null;
    if (!section || !video) return;

    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) video.play().catch(() => {});
        else video.pause();
      },
      { threshold: 0 }
    );
    io.observe(section);
  }

  initProgramsHeroVideoPause();
  document.addEventListener('astro:page-load', initProgramsHeroVideoPause);

  // Float-in/up reveal for "The Four Programs" intro -- same fly-in
  // (translateY + fade) treatment already used for the Approach and
  // Services page card reveals.
  function initProgramsIntroReveal() {
    const el = document.getElementById('programs-intro-reveal');
    if (!el) return;

    ScrollTrigger.getAll().forEach((st) => {
      if (st.trigger === el) st.kill();
    });

    gsap.set(el, { opacity: 0, y: 40 });
    gsap.to(el, {
      opacity: 1,
      y: 0,
      duration: 1,
      ease: 'power3.out',
      scrollTrigger: { trigger: el, start: 'top 85%', once: true },
    });
  }

  initProgramsIntroReveal();
  document.addEventListener('astro:page-load', initProgramsIntroReveal);

  // Each program section's card floats in from the left, its image floats
  // in from the right, converging into place together as that section
  // scrolls into view.
  function initProgramCardImageReveal() {
    const sections = document.querySelectorAll<HTMLElement>('[data-program-section]');

    sections.forEach((section) => {
      ScrollTrigger.getAll().forEach((st) => {
        if (st.trigger === section) st.kill();
      });

      const card = section.querySelector<HTMLElement>('[data-program-card]');
      const image = section.querySelector<HTMLElement>('[data-program-image]');
      if (!card) return;

      gsap.set(card, { opacity: 0, x: -60 });
      if (image) gsap.set(image, { opacity: 0, x: 60 });

      const tl = gsap.timeline({
        scrollTrigger: { trigger: section, start: 'top 70%', once: true },
        defaults: { duration: 1, ease: 'power3.out' },
      });
      tl.to(card, { opacity: 1, x: 0 }, 0);
      if (image) tl.to(image, { opacity: 1, x: 0 }, 0);
    });
  }

  initProgramCardImageReveal();
  document.addEventListener('astro:page-load', initProgramCardImageReveal);
</script>
