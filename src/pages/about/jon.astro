---
// Jon's Profile page, built from "jon's profile page flow.docx" (assets/
// jon's profile page/). Every career fact (companies, dates, figures)
// comes from "Jon Encarnacion - Head of Delivery - Resume 2026.pdf" in the
// same folder, not invented. See src/data/jonProfileContent.ts for the
// full data-sourcing notes.
//
// Consolidated from the flow doc's original 11-section architecture after
// comparing real leadership-bio pages at Deloitte and BCG (both far more
// compact than the doc's spec, even at 100x Coherenz's size) and Jon's own
// read that the full 11-section version felt overdone. "What Jon Brings"
// is now a tag row inside the hero instead of its own 4-card section;
// "Jon's Approach" and "AI-Assisted Practice" are folded into a sentence
// each in The Story instead of two more card-grid sections. See
// jonProfileContent.ts for what stayed structured data vs. became prose.
//
// "What They Say About Jon's Leadership" now renders real excerpts from a
// farewell letter written by Jon's former team (see jonProfileContent.ts
// for the full sourcing note) -- Jon confirmed consent was given to use
// these publicly. Company name and internal project/place names have been
// removed or generalized throughout.
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import FinalCta from '../../components/FinalCta.astro';
import InsightGridCard from '../../components/InsightGridCard.astro';
import { base } from '../../lib/base';
import {
  capabilityLenses,
  experienceEntries,
  questionsBehindTheWork,
  selectedThinkingSlugs,
  leadershipTestimonials,
} from '../../data/jonProfileContent';
import { insightArticles } from '../../data/insightArticles';
import {
  IconBulb,
  IconShieldCheck,
  IconUserCheck,
  IconAward,
  IconHeartHandshake,
  IconFocus2,
  IconTrendingUp,
  IconFlag3,
} from '@tabler/icons-react';
import { StaggerTestimonials } from '../../components/ui/stagger-testimonials';
import ValuesMarquee from '../../components/ui/values-marquee';
import EditorialCarousel from '../../components/ui/editorial-carousel';
import { BlurReveal } from '../../components/ui/blur-reveal.tsx';

const selectedThinking = selectedThinkingSlugs
  .map((slug) => insightArticles.find((a) => a.slug === slug))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));

// The 7 leadership values (same set behind the testimonials below),
// paired with a representative Tabler icon for the hero's values marquee.
const marqueeValues = [
  { label: 'Integrity', Icon: IconShieldCheck },
  { label: 'Trust', Icon: IconUserCheck },
  { label: 'Excellence', Icon: IconAward },
  { label: 'Empathy', Icon: IconHeartHandshake },
  { label: 'Clarity', Icon: IconFocus2 },
  { label: 'Growth', Icon: IconTrendingUp },
  { label: 'Commitment', Icon: IconFlag3 },
];
---

<Layout
  title="Jon Encarnacion — Coherenz"
  description="Product & Delivery Strategist. Jon Encarnacion advises product and technology leaders on diagnosing delivery complexity, improving the economics of product investment, and restoring execution clarity as organizations scale."
>
  <Nav />

  <section class="relative flex min-h-[70vh] items-end overflow-hidden bg-navy">
    <img
      src={`${base}img/photography/jon-profile-hero-bg.jpg`}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy via-navy/85 to-navy/50" />
    <div class="relative mx-auto w-full max-w-[1536px] px-6 py-20 sm:px-8 lg:px-10 xl:px-14">
      <div class="grid grid-cols-1 items-center gap-[60px] lg:grid-cols-[420px_1fr] lg:gap-[100px]">
        <BlurReveal client:visible delay={0} className="mx-auto block w-full max-w-[320px]">
          <img
            src={`${base}img/photography/jon-profile-hero.jpg`}
            alt="Jon Encarnacion, standing outdoors with arms crossed, smiling"
            class="aspect-square w-full rounded-full border-2 border-orange object-cover"
          />
        </BlurReveal>

        <div>
          <BlurReveal client:visible delay={0.1} className="block">
            <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">Jon Encarnacion</p>
          </BlurReveal>
          <BlurReveal client:visible delay={0.2} className="block">
            <h1 class="mt-3 max-w-2xl font-serif text-4xl text-white sm:text-5xl">Product & Delivery Strategist</h1>
          </BlurReveal>
          <BlurReveal client:visible delay={0.3} className="block">
            <p class="mt-4 max-w-xl text-white/75">
              Advises product and technology leaders on diagnosing delivery complexity, improving the economics of
              product investment, and restoring execution clarity as organizations scale.
            </p>
          </BlurReveal>

          {/* Expertise tags, BCG-style -- replaces the flow doc's separate
              "What Jon Brings" 4-card section; same four practitioner
              lenses, one compact row instead of a whole scroll stop. */}
          <BlurReveal client:visible delay={0.4} className="block">
            <div class="mt-6 flex flex-wrap gap-2">
              {capabilityLenses.map((lens) => (
                <span class="rounded-full border border-orange/30 px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-orange">
                  {lens.name}
                </span>
              ))}
            </div>
          </BlurReveal>
        </div>
      </div>
    </div>
  </section>

  {/* No client:* directive -- the marquee is pure CSS animation (no
      hooks/handlers), and its `values` prop carries React icon components,
      which Astro can't serialize across a client-hydration boundary. Astro
      still renders this to static HTML at request time either way. */}
  <ValuesMarquee values={marqueeValues} />

  <section class="bg-wash-blue py-16 sm:py-24">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <div class="perspective-float mx-auto max-w-2xl text-center">
        <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">The Story</p>
        <h2 class="mt-3 font-serif text-4xl text-navy sm:text-5xl">A career spent making complex things work.</h2>
        <p class="mt-6 text-foreground/70">
          Jon's career has taken him through complex product, technology, and delivery environments across
          telecommunications, enterprise platforms, energy, SaaS, and digital products.
        </p>
        <p class="mt-4 text-foreground/70">Across those environments, one challenge repeatedly surfaced:</p>
        <p class="mt-4 font-serif text-2xl text-navy">
          Organizations rarely struggle because people aren't working hard. They struggle when effort becomes
          increasingly difficult to connect to value.
        </p>
        <p class="mt-6 text-foreground/70">
          As organizations grow, priorities multiply, dependencies increase, teams specialize, and delivery systems
          become harder to see as a whole. Jon's experience working through those environments shaped a simple
          conviction:
        </p>
        <p class="mt-4 text-lg font-bold text-orange">
          Before asking an organization to move faster, understand what is making it slow.
        </p>
        <p class="mt-6 text-foreground/70">
          He starts by understanding the system rather than immediately prescribing a solution—looking at how
          investment, capacity, flow, quality, and coordination interact before recommending what to change. Where
          useful, he brings AI-assisted research and analysis into that work, to sharpen judgment, not replace it.
        </p>
        <p class="mt-4 text-foreground/70">That perspective became one of the foundations of Coherenz.</p>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <div class="hero-float-left">
        <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">Experience</p>
        <h2 class="mt-3 max-w-2xl font-serif text-4xl text-navy sm:text-5xl">
          Experience across complex product & technology environments.
        </h2>
        <p class="mt-4 max-w-2xl text-foreground/70">
          The perspective behind Coherenz has been shaped through years of product, technology, project, and
          delivery leadership across different industries and organizational environments.
        </p>
      </div>

      <div class="mt-[50px] flex flex-col divide-y divide-line border-t border-line" data-reveal-grid>
        {experienceEntries.map((entry, i) => (
          <div class="grid grid-cols-1 gap-2 py-6 sm:grid-cols-[220px_1fr] sm:gap-8" data-reveal-item style={`transition-delay: ${i * 150}ms`}>
            <div>
              <p class="text-xs font-bold uppercase tracking-wide text-orange">{entry.category}</p>
              <p class="mt-1 text-sm text-foreground/50">{entry.dates}</p>
            </div>
            <div>
              <p class="font-serif text-xl text-navy">{entry.role}</p>
              <p class="mt-1 text-sm font-semibold text-navy/70">{entry.org}</p>
              <p class="mt-2 text-sm text-foreground/70">{entry.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-cream py-16 sm:py-24">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <div class="perspective-float mx-auto max-w-2xl text-center">
        <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">What They Say About Jon's Leadership</p>
        <h2 class="mt-3 font-serif text-4xl text-navy sm:text-5xl">Leadership is experienced from the inside.</h2>
        <p class="mt-4 text-foreground/70">
          The strongest measure of leadership isn't the title. It's the experience of the people who worked with
          you. These reflections come from people Jon previously led, mentored, and worked alongside—people who
          experienced his approach to leadership firsthand.
        </p>
      </div>

      <div class="mt-[50px]">
        <StaggerTestimonials
          client:visible
          testimonials={leadershipTestimonials.map((t, i) => ({ tempId: i, quote: t.quote, by: t.by, value: t.value }))}
        />
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-navy py-20 sm:py-28">
    <div class="relative mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <p class="perspective-float text-center text-sm font-bold uppercase tracking-[0.375em] text-orange">The Questions Behind the Work</p>
      <div class="mt-[50px]">
        <EditorialCarousel client:visible items={questionsBehindTheWork} />
      </div>
    </div>
  </section>

  <section class="bg-wash-green py-16 sm:py-24">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <div class="hero-float-left">
        <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">Selected Thinking</p>
        <h2 class="mt-3 max-w-2xl font-serif text-4xl text-navy sm:text-5xl">Ideas behind the work.</h2>
        <p class="mt-2">
          <a href={`${base}insights`} class="font-bold text-orange">Explore all Insights →</a>
        </p>
      </div>

      <div class="mt-[50px] grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal-grid>
        {selectedThinking.map((article, i) => (
          <div data-reveal-item style={`transition-delay: ${i * 150}ms`}>
            <InsightGridCard
              title={article.title}
              description={article.subhead}
              image={article.heroImage}
              imageAlt={article.heroImageAlt}
              slug={article.slug}
              Icon={IconBulb}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-cream py-16 sm:py-24">
    <div class="perspective-float mx-auto max-w-2xl px-6 text-center sm:px-8">
      <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">Beyond the Frameworks</p>
      <h2 class="mt-3 font-serif text-4xl text-navy sm:text-5xl">Good consulting should make complexity feel simpler.</h2>
      <p class="mt-6 text-foreground/70">
        Outside the frameworks, Jon is curious by habit—drawn to understanding why systems work the way they do,
        whether that's a delivery organization or something entirely unrelated to work. He's spent much of his
        career mentoring people earlier in their careers, and still finds that some of the best thinking happens in
        conversation, not in a document.
      </p>
      <p class="mt-4 text-foreground/70">
        He believes good work should be rigorous and human at the same time—and that the measure of a good
        explanation is whether it makes something complicated feel a little more simple, not more impressive.
      </p>
    </div>
  </section>

  <div class="relative overflow-hidden bg-navy">
    <img
      src={`${base}img/monogram.svg`}
      alt=""
      class="pointer-events-none absolute -right-6 -top-20 w-96 opacity-[0.22] sm:-right-4 sm:w-[30rem]"
    />
    <FinalCta
      showPortrait={false}
      showMonogram={false}
      transparent
      eyebrow="Let's Talk"
      body="Start with the problem. We can work out the right conversation from there."
      ctaText="Start a Conversation →"
      ctaHref={`${base}contact`}
      secondaryCtaText="Explore the Coherenz Diagnostic →"
      secondaryCtaHref={`${base}programs/product-delivery-economics-assessment`}
    >
      <Fragment slot="headline">Have a product or delivery problem you're trying to make sense of?</Fragment>
    </FinalCta>
    <Footer transparent />
  </div>
</Layout>

<style>
  /* Same reveal-on-scroll vocabulary used across the rest of the site
     (services/[slug].astro, programs/[slug].astro, insights.astro, etc.)
     -- this page previously had no scroll animation at all beyond the
     self-contained islands (ValuesMarquee, StaggerTestimonials,
     EditorialCarousel) and FinalCta's own built-in reveal. */
  .hero-float-left {
    opacity: 0;
    transform: translateX(-28px);
    transition:
      opacity 1500ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 1500ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .hero-float-left.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  .perspective-float {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 1500ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 1500ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .perspective-float.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  [data-reveal-item] {
    --reveal-duration: 1500ms;
    opacity: 0;
    transform: translateX(-28px);
    transition:
      opacity var(--reveal-duration) cubic-bezier(0.23, 1, 0.32, 1),
      transform var(--reveal-duration) cubic-bezier(0.23, 1, 0.32, 1);
  }

  [data-reveal-item].is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-float-left,
    .perspective-float,
    [data-reveal-item] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initHeroFloatLeft() {
    document.querySelectorAll<HTMLElement>('.hero-float-left').forEach((el) => {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          el.classList.add('is-visible');
          io.disconnect();
        },
        { threshold: 0.2 }
      );
      io.observe(el);
    });
  }

  function initPerspectiveFloat() {
    document.querySelectorAll<HTMLElement>('.perspective-float').forEach((el) => {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          el.classList.add('is-visible');
          io.disconnect();
        },
        { threshold: 0.2 }
      );
      io.observe(el);
    });
  }

  function initRevealGrids() {
    document.querySelectorAll<HTMLElement>('[data-reveal-grid]').forEach((grid) => {
      const items = grid.querySelectorAll<HTMLElement>('[data-reveal-item]');
      if (!items.length) return;
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          items.forEach((el) => el.classList.add('is-visible'));
          io.disconnect();
        },
        { threshold: 0.2 }
      );
      io.observe(grid);
    });
  }

  function init() {
    initHeroFloatLeft();
    initPerspectiveFloat();
    initRevealGrids();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
