---
// "Talk to Coherenz" page, built from "talk to coherenz page flow.docx"
// (assets/talk to coherenz page/) -- section order and copy below follow
// that doc directly. See src/data/contactPageContent.ts for the data and
// a note on the one deliberate deviation (route: /contact, not the doc's
// suggested /talk-to-coherenz -- every existing "Start a conversation" CTA
// sitewide already points at /contact).
//
// FORM BACKEND -- routes to jon.encarnacion@gmail.com via FormSubmit.co's
// AJAX endpoint (https://formsubmit.co/ajax/<email>), chosen as a stopgap
// specifically because it needs no account, no API key, and no server --
// it just emails whatever fields are POSTed to it, which fits a static
// GitHub Pages site with nothing else to call. This is NOT meant to be
// permanent: it's a free third-party service (rate-limited, no delivery
// guarantees, and the destination email is visible in this file's client-
// side source), so revisit if inquiry volume grows or Jon wants first-
// party control -- e.g. a paid Formspree plan or a small serverless
// function. Two things Jon needs to know:
//   1. ONE-TIME ACTIVATION: FormSubmit emails a confirmation link to
//      jon.encarnacion@gmail.com after the very first real submission.
//      Until that link is clicked, submissions silently don't arrive.
//   2. Their captcha is disabled below (_captcha: 'false') so the in-page
//      sending/success flow doesn't get redirected to FormSubmit's own
//      page -- the only spam mitigation is the honeypot field (_honey)
//      also below, which is much weaker than a real captcha.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ChallengeCard } from '../components/ui/card-21';
import { base } from '../lib/base';
import {
  problemCards,
  processSteps,
  topicOptions,
  roleSuggestions,
  MESSAGE_MAX_LENGTH,
} from '../data/contactPageContent';
import {
  IconGauge,
  IconUsersGroup,
  IconScale,
  IconArrowsShuffle,
  IconHierarchy3,
  IconHelpCircle,
  IconSearch,
  IconMicroscope,
  IconTargetArrow,
  IconArrowRight,
  IconArrowDown,
  IconCheck,
} from '@tabler/icons-react';

const problemIcons = [IconGauge, IconUsersGroup, IconScale, IconArrowsShuffle, IconHierarchy3, IconHelpCircle];
const processIcons = [IconSearch, IconMicroscope, IconTargetArrow];

// Section 05 -- reuses ChallengeCard exactly as FourProblems.astro and
// programs/[slug].astro already do, rather than building new card markup.
const alternativePaths = [
  {
    imageUrl: `${base}img/programs/diagnostic.jpg`,
    headline: 'Where is the friction in your delivery system?',
    label: 'Understand the Problem',
    desc: 'Explore the Product Delivery Economics Assessment and the dimensions used to identify potential sources of delivery friction and economic leakage.',
    href: `${base}programs/product-delivery-economics-assessment`,
    themeColor: '36 80% 55%',
    leftAlignText: true,
    splitLayout: true,
    framedImage: true,
    swapLabelCta: true,
    compactHeadline: true,
    ctaLabel: 'Explore the Assessment',
  },
  {
    imageUrl: `${base}img/photography/insight-top.jpg`,
    headline: 'Start with a different question.',
    label: 'Explore the Ideas',
    desc: 'Explore perspectives on product investment, delivery complexity, capacity, coordination, and building more economically effective product organizations.',
    href: `${base}insights`,
    themeColor: '212 44% 32%',
    leftAlignText: true,
    splitLayout: true,
    framedImage: true,
    swapLabelCta: true,
    compactHeadline: true,
    ctaLabel: 'Read the Insights',
  },
];
---

<Layout
  title="Talk to Coherenz | Product & Delivery Strategy"
  description="Talk to Coherenz about the product, delivery, prioritization, or organizational challenges affecting your ability to create and deliver value."
>
  <Nav />

  {/* bg-navy, not the doc's implied light/calm treatment -- Nav.astro's
      fixed header is transparent with white text/logo until the visitor
      scrolls (see its own scroll listener), which only reads correctly
      over a dark hero. Every other page in this codebase opens on navy or
      a navy-overlaid photo for the same reason; a light hero here would
      make the nav illegible at the top of the page. */}
  <section class="bg-navy pt-32 pb-16 sm:pt-40 sm:pb-24">
    <div class="hero-fade mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">Talk to Coherenz</p>
      <h1 class="mt-3 max-w-3xl font-serif text-4xl text-white sm:text-6xl">Let's talk about what's getting in the way.</h1>
      <p class="mt-5 max-w-2xl text-lg text-white/70">
        Whether you're dealing with delivery friction, unclear product priorities, increasing coordination costs, or
        an operating model that no longer fits your organization, we can start with a conversation.
      </p>
      <p class="mt-3 max-w-2xl text-white/50 italic">
        You don't need to have the problem fully defined before reaching out.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="#form" class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-bold text-primary-foreground">
          Start the Conversation
          <IconArrowDown size={16} stroke={2} />
        </a>
        <a href="#challenges" class="inline-flex items-center gap-2 rounded-full border-2 border-orange px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-white/10">
          Explore the Questions
          <IconArrowDown size={16} stroke={2} />
        </a>
      </div>
    </div>
  </section>

  <section id="challenges" class="scroll-anchor bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <div class="hero-fade max-w-2xl">
        <h2 class="font-serif text-4xl text-navy sm:text-5xl">You might be here because&hellip;</h2>
        <p class="mt-4 text-foreground/70">
          Something in your product or delivery system isn't working as well as it should. The challenge may be
          clear&mdash;or you may simply know that the current way of working is becoming harder to sustain.
        </p>
      </div>

      <div class="challenge-grid mt-[50px] grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal-grid>
        {problemCards.map((card, i) => {
          const Icon = problemIcons[i];
          return (
            <button
              type="button"
              class="challenge-card reveal-item flex flex-col items-start gap-3 border border-line bg-white p-6 text-left transition-colors hover:border-orange/50"
              data-challenge-id={card.id}
              data-challenge-label={card.headline}
              aria-pressed="false"
              style={`transition-delay: ${i * 120}ms`}
            >
              {/* Visibility toggled directly by contact-form.js's click
                  handler (classList on these two spans, not a Tailwind
                  group-[.is-selected]: arbitrary variant -- that syntax
                  didn't generate working CSS here, so this avoids relying
                  on it working at all). */}
              <span class="challenge-check-off flex h-10 w-10 items-center justify-center rounded-full border border-orange/40 text-orange transition-colors">
                <Icon size={20} stroke={1.8} />
              </span>
              <span class="challenge-check-on hidden h-10 w-10 items-center justify-center rounded-full border border-navy bg-navy text-orange">
                <IconCheck size={20} stroke={2.2} />
              </span>
              <p class="font-serif text-lg text-navy">{card.headline}</p>
              <p class="text-sm text-foreground/60">{card.description}</p>
            </button>
          );
        })}
      </div>

      <p class="mt-6 text-sm text-foreground/50">
        Select as many as apply&mdash;or none. This isn't required to reach out.
      </p>
    </div>
  </section>

  <section class="bg-navy py-16 sm:py-24">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <div class="hero-fade max-w-2xl">
        <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">The First Conversation</p>
        <h2 class="mt-3 font-serif text-4xl text-white sm:text-5xl">A conversation, not a sales pitch.</h2>
        <p class="mt-4 text-white/70">
          The purpose of the first conversation is to better understand what's happening and determine whether
          Coherenz can meaningfully help.
        </p>
      </div>

      <div class="process-grid mt-[50px] flex flex-col gap-3 lg:flex-row lg:items-stretch lg:gap-0" data-reveal-grid>
        {processSteps.map((step, i) => {
          const Icon = processIcons[i];
          return (
            <>
              {i > 0 && (
                <div
                  class="reveal-item hidden shrink-0 items-center justify-center px-4 text-white/30 lg:flex"
                  aria-hidden="true"
                  style={`transition-delay: ${i * 150}ms`}
                >
                  &rarr;
                </div>
              )}
              <div
                class="reveal-item flex flex-1 flex-col gap-3 border border-white/15 bg-white/5 p-6"
                style={`transition-delay: ${i * 150}ms`}
              >
                <span class="flex h-10 w-10 items-center justify-center rounded-full border border-orange/40 text-orange">
                  <Icon size={20} stroke={1.8} />
                </span>
                <p class="text-xs font-bold uppercase tracking-wide text-orange">{step.number} &mdash; {step.name}</p>
                <p class="font-serif text-lg text-white">{step.headline}</p>
                <p class="text-sm text-white/70">{step.description}</p>
              </div>
            </>
          );
        })}
      </div>
    </div>
  </section>

  <section id="form" class="scroll-anchor bg-wash-blue py-16 sm:py-24">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <div class="hero-fade mx-auto max-w-2xl text-center">
        <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">Start the Conversation</p>
        <h2 class="mt-3 font-serif text-4xl text-navy sm:text-5xl">Tell me a little about your situation.</h2>
        <p class="mt-4 text-foreground/70">
          You don't need to have everything figured out. Share what you're experiencing, and we'll take it from
          there.
        </p>
      </div>

      <div class="hero-fade mx-auto mt-[50px] max-w-2xl">
        <form id="contact-form" class="border border-line bg-white p-6 sm:p-10" novalidate>
          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div class="sm:col-span-1">
              <label for="cf-name" class="text-xs font-bold uppercase tracking-wide text-navy">Your name</label>
              <input
                id="cf-name"
                name="name"
                type="text"
                required
                autocomplete="name"
                class="form-input mt-2 w-full border border-line bg-white px-4 py-3 text-navy placeholder:text-foreground/40 focus:border-orange focus:outline-none"
              />
              <p class="form-error mt-1 hidden text-sm text-destructive" data-error-for="name">Please share your name.</p>
            </div>

            <div class="sm:col-span-1">
              <label for="cf-email" class="text-xs font-bold uppercase tracking-wide text-navy">Work email</label>
              <input
                id="cf-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                class="form-input mt-2 w-full border border-line bg-white px-4 py-3 text-navy placeholder:text-foreground/40 focus:border-orange focus:outline-none"
              />
              <p class="form-error mt-1 hidden text-sm text-destructive" data-error-for="email">Please enter a valid email address.</p>
            </div>

            <div class="sm:col-span-1">
              <label for="cf-company" class="text-xs font-bold uppercase tracking-wide text-navy">Company or organization</label>
              <input
                id="cf-company"
                name="company"
                type="text"
                autocomplete="organization"
                class="form-input mt-2 w-full border border-line bg-white px-4 py-3 text-navy placeholder:text-foreground/40 focus:border-orange focus:outline-none"
              />
            </div>

            <div class="sm:col-span-1">
              <label for="cf-role" class="text-xs font-bold uppercase tracking-wide text-navy">Your role</label>
              <input
                id="cf-role"
                name="role"
                type="text"
                list="cf-role-suggestions"
                placeholder="e.g. Product Leader"
                class="form-input mt-2 w-full border border-line bg-white px-4 py-3 text-navy placeholder:text-foreground/40 focus:border-orange focus:outline-none"
              />
              <datalist id="cf-role-suggestions">
                {roleSuggestions.map((role) => <option value={role} />)}
              </datalist>
            </div>
          </div>

          <fieldset class="mt-6">
            <legend class="text-xs font-bold uppercase tracking-wide text-navy">What would you like to talk about?</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {topicOptions.map((topic, i) => (
                <div>
                  <input type="checkbox" name="topics" id={`cf-topic-${i}`} value={topic} class="peer sr-only" />
                  <label
                    for={`cf-topic-${i}`}
                    class="inline-block cursor-pointer border border-line px-4 py-2 text-sm text-navy transition-colors peer-checked:border-navy peer-checked:bg-navy peer-checked:text-orange peer-focus-visible:ring-2 peer-focus-visible:ring-ring"
                  >
                    {topic}
                  </label>
                </div>
              ))}
            </div>
          </fieldset>

          <div class="mt-6">
            <label for="cf-message" class="text-xs font-bold uppercase tracking-wide text-navy">What's happening?</label>
            <textarea
              id="cf-message"
              name="message"
              rows="5"
              maxlength={MESSAGE_MAX_LENGTH}
              placeholder="Tell me as much or as little as you'd like about the challenge you're trying to solve."
              class="form-input mt-2 w-full resize-y border border-line bg-white px-4 py-3 text-navy placeholder:text-foreground/40 focus:border-orange focus:outline-none"
            ></textarea>
            <p class="mt-1 text-right text-xs text-foreground/40"><span id="cf-message-count">0</span> / {MESSAGE_MAX_LENGTH}</p>
          </div>

          {/* Selected challenge cards from Section 02 are copied in here as
              hidden checkboxes by contact-form.js on selection, so they
              travel with the rest of the form data without any shared
              React state between the two sections. */}
          <div id="cf-selected-challenges" class="hidden"></div>

          {/* FormSubmit's honeypot convention: real visitors never see or
              fill this (tabindex -1, visually hidden, no autofill hook),
              bots that blindly fill every field do -- FormSubmit silently
              drops the submission when it's non-empty. */}
          <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <p id="cf-submit-error" class="mb-4 hidden text-sm text-destructive">
            Something went wrong sending your message. Please try again, or email{' '}
            <a href="mailto:jon.encarnacion@gmail.com" class="font-bold underline">jon.encarnacion@gmail.com</a> directly.
          </p>

          <button
            type="submit"
            id="cf-submit"
            class="mt-7 inline-flex w-full items-center justify-center gap-2 rounded-full bg-primary px-6 py-3.5 text-sm font-bold text-primary-foreground transition-opacity disabled:opacity-60 sm:w-auto"
          >
            <span data-submit-label>Start the Conversation &rarr;</span>
          </button>

          <p class="mt-4 text-xs text-foreground/50">
            Your information will only be used to respond to your inquiry. No spam. No unnecessary follow-ups.
          </p>
        </form>

        <div id="cf-success" class="hidden border border-line bg-white p-6 text-center sm:p-10">
          <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full border-2 border-orange text-orange">
            <IconCheck size={26} stroke={2.4} />
          </span>
          <h3 class="mt-5 font-serif text-3xl text-navy">Thanks for reaching out.</h3>
          <p class="mt-3 text-foreground/70">
            Your message has been received. I'll review what you've shared and get back to you personally.
          </p>
          <p class="mt-3 text-foreground/70">
            In the meantime, you may want to explore some of the ideas and questions shaping how Coherenz approaches
            product and delivery challenges.
          </p>
          <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
            <a href={`${base}insights`} class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-bold text-primary-foreground">
              Explore the Insights
              <IconArrowRight size={16} stroke={2} />
            </a>
            <a href={base} class="inline-flex items-center gap-2 rounded-full border-2 border-orange px-6 py-3 text-sm font-bold text-navy transition-colors hover:bg-orange/10">
              Return to Home
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cream py-16 sm:py-24">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <div class="hero-fade mx-auto max-w-2xl text-center">
        <h2 class="font-serif text-4xl text-navy sm:text-5xl">Not ready to talk yet?</h2>
        <p class="mt-4 text-foreground/70">
          You may still be working to understand what's happening. These are good places to start.
        </p>
      </div>

      <div class="mt-[50px] grid grid-cols-1 gap-6 sm:grid-cols-2">
        {alternativePaths.map((item) => (
          <div class="h-[420px]">
            <ChallengeCard {...item} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-navy py-16 sm:py-24">
    <img src={`${base}img/monogram.svg`} alt="" class="pointer-events-none absolute -right-10 -top-16 w-72 opacity-[0.22] sm:-right-6 sm:-top-20 sm:w-96" />
    <div class="relative mx-auto flex max-w-[1536px] flex-col items-center gap-[100px] px-6 sm:px-8 lg:px-10 xl:px-14 lg:flex-row">
      <div class="hero-fade order-2 flex shrink-0 justify-start lg:order-1">
        <img
          src={`${base}img/photography/founder-cta-portrait.png`}
          alt="Jon Encarnacion, Founder & Principal, Coherenz"
          class="w-full max-w-[340px] sm:max-w-[400px]"
        />
      </div>
      <div class="hero-fade order-1 text-left lg:order-2">
        <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">Direct Conversation</p>
        <h2 class="mt-3 max-w-xl font-serif text-4xl text-white sm:text-5xl">You'll be talking directly with Jon.</h2>
        <p class="mt-4 max-w-xl text-white/70">
          Coherenz is a founder-led practice. The initial conversation happens directly with Jon
          Encarnacion&mdash;the practitioner behind Coherenz. There are no sales layers or account handoffs between
          the challenge you're experiencing and the person helping you make sense of it.
        </p>
        <p class="mt-3 max-w-xl text-white/70">
          The goal is simple: understand the situation, determine whether Coherenz can help, and identify the most
          useful next step.
        </p>
        <a href={`${base}about/jon`} class="mt-6 inline-flex items-center gap-2 rounded-full border-2 border-orange px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-white/10">
          Meet Jon
          <IconArrowRight size={16} stroke={2} />
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Smooth-scroll for the hero's two anchor CTAs (#challenges, #form), per
     the doc's "Anchor CTAs should use smooth scrolling" note -- no existing
     site page does this yet (confirmed nothing else sets
     scroll-behavior: smooth), so it's introduced fresh here rather than
     copied from a precedent. scroll-margin-top offsets both anchor targets
     so their heading doesn't land hidden under the fixed Nav. */
  :global(html) {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }

  .scroll-anchor {
    scroll-margin-top: 96px;
  }

  /* Fade+rise entrance for section intros, same character as the rest of
     the site's reveal patterns (1500ms, strong ease-out) but a plain fade
     + shorter rise instead of the usual 28px horizontal float, since these
     sections are centered/full-width rather than left-anchored. */
  .hero-fade {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 1200ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 1200ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .hero-fade.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .reveal-item {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 1200ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 1200ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .reveal-item.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-fade,
    .reveal-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .form-input:invalid.touched {
    border-color: var(--color-destructive);
  }
</style>

<script>
  // Fade-in for hero/section-intro blocks (.hero-fade) and staggered card
  // grids (.reveal-item inside [data-reveal-grid]) -- same
  // IntersectionObserver-once-then-disconnect pattern used across the site
  // (see services.astro, FourProblems.astro, FinalCta.astro), re-run on
  // astro:page-load for view-transition navigation.
  function initReveals() {
    document.querySelectorAll<HTMLElement>('.hero-fade').forEach((el) => {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          el.classList.add('is-visible');
          io.disconnect();
        },
        { threshold: 0.15 }
      );
      io.observe(el);
    });

    document.querySelectorAll<HTMLElement>('[data-reveal-grid]').forEach((grid) => {
      const items = grid.querySelectorAll<HTMLElement>('.reveal-item');
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          items.forEach((el) => el.classList.add('is-visible'));
          io.disconnect();
        },
        { threshold: 0.15 }
      );
      io.observe(grid);
    });
  }

  // Section 02 -- challenge card multi-select. Toggling a card also writes
  // (or removes) a hidden checkbox inside the form so the selection travels
  // with the rest of the form data on submit, without needing shared React
  // state between two otherwise-independent sections.
  function initChallengeCards() {
    const container = document.getElementById('cf-selected-challenges');
    document.querySelectorAll<HTMLButtonElement>('.challenge-card').forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.dataset.challengeId!;
        const label = card.dataset.challengeLabel!;
        const selected = card.classList.toggle('is-selected');
        card.classList.toggle('border-navy', selected);
        card.classList.toggle('bg-wash-blue/40', selected);
        card.setAttribute('aria-pressed', String(selected));
        card.querySelector('.challenge-check-off')?.classList.toggle('hidden', selected);
        card.querySelector('.challenge-check-on')?.classList.toggle('hidden', !selected);
        card.querySelector('.challenge-check-on')?.classList.toggle('flex', selected);

        const existing = container?.querySelector(`input[value="${CSS.escape(id)}"]`);
        if (selected && !existing && container) {
          const input = document.createElement('input');
          input.type = 'checkbox';
          input.name = 'challenges';
          input.value = id;
          input.dataset.label = label;
          input.checked = true;
          container.appendChild(input);
        } else if (!selected && existing) {
          existing.remove();
        }
      });
    });
  }

  // Section 04 -- textarea character counter (soft guidance only; the
  // field itself is optional and maxlength already hard-caps input).
  function initMessageCounter() {
    const textarea = document.getElementById('cf-message') as HTMLTextAreaElement | null;
    const count = document.getElementById('cf-message-count');
    if (!textarea || !count) return;
    const update = () => (count.textContent = String(textarea.value.length));
    textarea.addEventListener('input', update);
    update();
  }

  // Section 04/07 -- validation, submit states, and the success view swap.
  //
  // TODO(form-backend): the payload below is fully assembled per the doc's
  // recommended shape (name/email/company/role/topics/challenges/message/
  // page source/timestamp, plus best-effort referrer + UTM capture) but is
  // only logged to the console -- nothing sends it anywhere yet. Wire the
  // fetch() call where marked once Jon picks a form backend (Formspree,
  // Netlify Forms, a serverless function, etc.); everything else on this
  // page (validation, inline errors, sending/success states) is ready to
  // ship as-is.
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const success = document.getElementById('cf-success');
    const submitBtn = document.getElementById('cf-submit') as HTMLButtonElement | null;
    const submitLabel = submitBtn?.querySelector('[data-submit-label]');
    if (!form || !success || !submitBtn || !submitLabel) return;

    const nameInput = form.elements.namedItem('name') as HTMLInputElement;
    const emailInput = form.elements.namedItem('email') as HTMLInputElement;
    const errorBanner = document.getElementById('cf-submit-error');

    const setError = (field: string, show: boolean) => {
      const input = form.querySelector<HTMLElement>(`#cf-${field}`);
      const error = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
      input?.classList.add('touched');
      if (input) input.classList.toggle('invalid', show);
      error?.classList.toggle('hidden', !show);
    };

    const isValidEmail = (value: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitBtn.disabled) return;

      const nameValid = nameInput.value.trim().length > 0;
      const emailValid = isValidEmail(emailInput.value.trim());
      setError('name', !nameValid);
      setError('email', !emailValid);
      if (!nameValid || !emailValid) return;

      submitBtn.disabled = true;
      submitLabel.textContent = 'Sending...';
      errorBanner?.classList.add('hidden');

      const formData = new FormData(form);
      const params = new URLSearchParams(window.location.search);
      const topics = (formData.getAll('topics') as string[]).join(', ') || 'None selected';
      const challenges =
        Array.from(document.querySelectorAll<HTMLInputElement>('#cf-selected-challenges input'))
          .map((i) => i.dataset.label)
          .join(', ') || 'None selected';

      const payload = {
        name: formData.get('name'),
        email: formData.get('email'),
        company: formData.get('company') || 'Not provided',
        role: formData.get('role') || 'Not provided',
        'conversation topics': topics,
        'selected challenges': challenges,
        message: formData.get('message') || 'Not provided',
        'page source': window.location.pathname,
        'submitted at': new Date().toISOString(),
        referrer: document.referrer || 'Direct / unknown',
        utm_source: params.get('utm_source') || '',
        utm_medium: params.get('utm_medium') || '',
        utm_campaign: params.get('utm_campaign') || '',
        // FormSubmit reserved config keys -- see file-header comment.
        _subject: 'New inquiry from Talk to Coherenz',
        _template: 'box',
        _captcha: 'false',
        _honey: formData.get('_honey') || '',
      };

      try {
        const response = await fetch('https://formsubmit.co/ajax/jon.encarnacion@gmail.com', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!response.ok) throw new Error(`FormSubmit responded ${response.status}`);

        form.classList.add('hidden');
        success.classList.remove('hidden');
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (err) {
        console.error('[contact-form] submission failed:', err);
        errorBanner?.classList.remove('hidden');
        submitBtn.disabled = false;
        submitLabel.textContent = 'Start the Conversation →';
      }
    });

    [nameInput, emailInput].forEach((input) => {
      input.addEventListener('input', () => {
        if (!input.classList.contains('touched')) return;
        if (input === nameInput) setError('name', input.value.trim().length === 0);
        if (input === emailInput) setError('email', !isValidEmail(input.value.trim()));
      });
    });
  }

  function init() {
    initReveals();
    initChallengeCards();
    initMessageCounter();
    initContactForm();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
