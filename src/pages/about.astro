<style>
  /* Shared sequential-reveal mechanic for the page's single-row card
     groups (Five Lenses, Shift, How We Work, Promise checklist) -- fly in
     from the left, one shared IntersectionObserver trigger per grid, each
     item's stagger set via its own inline transition-delay. Duration is a
     custom property (default 1500ms) so the brisker Promise checklist
     (800ms) doesn't need a second copy of this block; it overrides
     --reveal-duration inline instead. Doesn't cover exp-card below --
     that one floats up from the bottom and wraps into multiple rows, a
     genuinely different mechanic, not more of this one. */
  [data-reveal-item] {
    --reveal-duration: 1500ms;
    opacity: 0;
    transform: translateX(-28px);
    transition:
      opacity var(--reveal-duration) cubic-bezier(0.23, 1, 0.32, 1),
      transform var(--reveal-duration) cubic-bezier(0.23, 1, 0.32, 1);
  }

  [data-reveal-item].is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal-item] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initSequentialReveal() {
    document.querySelectorAll<HTMLElement>('[data-reveal-grid]').forEach((grid) => {
      const items = grid.querySelectorAll<HTMLElement>('[data-reveal-item]');
      if (!items.length) return;

      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          items.forEach((el) => el.classList.add('is-visible'));
          io.disconnect();
        },
        { threshold: 0.2 }
      );
      io.observe(grid);
    });
  }

  initSequentialReveal();
  document.addEventListener('astro:page-load', initSequentialReveal);
</script>

<style>
  /* The five experience-area cards wrap into multiple rows at narrower
     widths (2-col, then 5-col), unlike the single-row card strips
     elsewhere on the site -- so these float up from the bottom instead of
