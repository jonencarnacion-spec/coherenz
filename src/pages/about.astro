---
// About page, built from "about page flow.docx" (assets/about page/) --
// every section, headline, and body copy below follows that doc's
// structure and wording directly; nothing here is drafted content.
// See src/data/aboutContent.ts for the source data specific to this page.
//
// The doc's "Optional CTA" on the Experience section ("View Jon's Full
// Profile →") is intentionally omitted -- no destination page or external
// profile URL exists yet, and per this project's no-fabrication rule this
// isn't invented. Flag to Jon if he wants a LinkedIn link or dedicated
// profile page built for it.
//
// The 5-lens diagnostic visual reuses servicesContent.ts's systemDimensions
// + the exact dim-grid/dim-card pattern already live on the Services page
// and the Insight article template (DiagnosticQuestions.astro) -- same
// framework, so intentionally the same component logic, not a new one.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FinalCta from '../components/FinalCta.astro';
import LinearCard from '../components/ui/linear-card.tsx';
import { BlurReveal } from '../components/ui/blur-reveal.tsx';
import { base } from '../lib/base';
import { systemDimensions } from '../data/servicesContent';
import { coherenzShifts, experienceAreas, howWeWork, promisePoints, beliefChain } from '../data/aboutContent';
import {
  IconTarget,
  IconRoute,
  IconBackpack,
  IconClipboardCheck,
  IconAffiliate,
  IconFlag,
  IconNetwork,
  IconBolt,
  IconDeviceLaptop,
  IconHierarchy3,
  IconScale,
  IconTools,
  IconSparkles,
  IconGitMerge,
  IconCircleCheckFilled,
} from '@tabler/icons-react';

const dimensionIcons = [IconTarget, IconRoute, IconBackpack, IconClipboardCheck, IconAffiliate];
const experienceIcons = [IconFlag, IconNetwork, IconBolt, IconDeviceLaptop, IconHierarchy3];

// The Shift's card images -- abstract "system" photography, same curated
// library as the rest of the page's imagery (assets/image options/insights
// images/the shift/).
const shiftCardImages = ['shift-1.jpg', 'shift-2.jpg', 'shift-3.jpg'];
// Longer version of each shift's description, shown only in the expanded
// modal -- the collapsed card keeps the shorter doc-sourced sentence as its
// teaser. Expands on the same point already made, not a new claim.
const shiftCardDescriptionsLong = [
  "Being busy is not the same as creating value. Coherenz helps leaders understand whether the work consuming organizational capacity is actually contributing to meaningful outcomes. Teams can be fully utilized—sprints full, backlogs moving, meetings running—while the organization still struggles to point to what changed for the business as a result. The shift starts with a different question: not how much are we doing, but what is that effort actually producing.",
  "Every delay, dependency, quality issue, and coordination burden has an economic consequence. Product delivery should be managed with greater visibility into the cost of complexity and the value created by investment. Treating delivery as a pipeline to keep full misses the point—what matters is whether that pipeline is producing outcomes worth what they cost. Delivery economics puts a real cost on every friction point, so leaders can weigh a fix against what it's actually worth.",
  "Adding people, processes, or meetings can temporarily relieve pressure. Sustainable improvement requires understanding the system producing the problem in the first place. A new tool or an extra approval step might ease the immediate strain, but if the underlying structure stays the same, the same pressure resurfaces somewhere else. Lasting change means redesigning how decisions, capacity, and coordination actually work together.",
];
const shiftCardItems = coherenzShifts.map((shift, i) => ({
  id: i,
  image: `${base}img/photography/${shiftCardImages[i]}`,
  eyebrow: shift.number,
  title: `${shift.from} → ${shift.to}`,
  description: shift.description,
  descriptionLong: shiftCardDescriptionsLong[i],
}));
const workIcons = [IconGitMerge, IconScale, IconTools, IconSparkles];
---

<Layout
  title="About — Coherenz"
  description="Coherenz was founded to help leaders restore the connection between effort and value. Learn the belief, the founder, and the practitioner experience behind Product Delivery Economics™."
>
  <Nav />

  <section id="about-hero" class="relative flex min-h-screen items-end overflow-hidden bg-navy">
    <video id="about-hero-video" class="absolute inset-0 h-full w-full object-cover" autoplay muted loop playsinline>
      <source src={`${base}video/about-hero.mp4`} type="video/mp4" />
    </video>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy via-navy/80 to-navy/30" />
    <div class="relative mx-auto w-full max-w-[1536px] px-6 py-20 sm:px-8 lg:px-10 xl:px-14">
      <BlurReveal client:visible delay={0} className="block">
        <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">About Coherenz</p>
      </BlurReveal>
      <BlurReveal client:visible delay={0.1} className="block">
        <h1 class="mt-3 max-w-3xl font-serif text-4xl text-white sm:text-5xl">
          Product organizations don't usually struggle because people aren't working hard.
        </h1>
      </BlurReveal>
      <BlurReveal client:visible delay={0.2} className="block">
        <p class="mt-4 max-w-2xl text-white/85">They struggle when growth and complexity quietly disconnect effort from value.</p>
      </BlurReveal>
      <BlurReveal client:visible delay={0.3} className="block">
        <p class="mt-3 max-w-2xl text-[14px] text-white/70">
          As organizations scale, more teams, initiatives, processes, and dependencies are introduced to solve bigger
          problems. But complexity can also create friction—slowing decisions, fragmenting accountability, consuming
          capacity, and making it increasingly difficult to see whether effort is actually producing meaningful
          outcomes.
        </p>
      </BlurReveal>
      <BlurReveal client:visible delay={0.4} className="block">
        <p class="mt-4 text-lg font-bold text-orange">Coherenz was founded to help leaders restore that connection.</p>
      </BlurReveal>
    </div>
  </section>

  <section class="bg-white py-[77px] sm:py-[115px]">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <div class="grid grid-cols-1 items-center gap-[60px] lg:grid-cols-2 lg:gap-[100px]">
        <div class="hero-float-left">
          <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">The Coherenz Belief</p>
          <h2 class="mt-3 max-w-2xl font-serif text-4xl text-navy sm:text-5xl">
            Complexity is inevitable. Disconnection doesn't have to be.
          </h2>
          <p class="mt-4 max-w-2xl text-foreground/70">
            Coherenz believes that product organizations should be understood as connected systems—not as isolated
            teams, projects, backlogs, or delivery metrics. A decision made in one part of the organization rarely
            stays contained there—it moves through investment, delivery, and outcomes long after the meeting that
            made it.
          </p>
          <p class="mt-3 max-w-2xl text-foreground/70">Every important decision affects something else.</p>
        </div>

        <div class="float-up">
          <img
            src={`${base}img/photography/about-belief.jpg`}
            alt="A 3D-rendered abstract sculpture of a figure with an explosion of interconnected pipe-like structures and translucent forms bursting from it, evoking hidden complexity within a system"
            class="aspect-square w-4/5 object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-[77px] sm:py-[115px]">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <div class="grid grid-cols-1 items-center gap-[60px] lg:grid-cols-2 lg:gap-[100px]">
        <div class="hero-float-left order-2 lg:order-1">
          <img
            src={`${base}img/photography/about-belief-2.jpg`}
            alt="A crystalline network junction radiating red and blue neon lines from a central node, evoking a single decision propagating through an interconnected system"
            class="aspect-square w-4/5 object-cover"
          />
        </div>

        <div class="float-up order-1 lg:order-2">
          <h2 class="max-w-2xl font-serif text-4xl text-navy sm:text-5xl">
            A single decision moves through the whole system.
          </h2>
          <p class="mt-4 max-w-2xl text-foreground/70">
            {beliefChain.join(' ')} When these relationships are invisible, organizations can become extremely busy
            without becoming meaningfully more effective.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="belief" class="relative overflow-hidden bg-navy py-16 text-white sm:py-24">
    <img src={`${base}img/coherenz-view-bg.jpg`} alt="" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-r from-navy/90 to-navy/30" />
    <div class="relative mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <div class="hero-float-left">
        <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">The Coherenz View</p>
        <h2 class="mt-3 max-w-2xl font-serif text-4xl text-white sm:text-5xl">
          Every symptom traces back to the same system.
        </h2>
        <p class="mt-4 max-w-2xl text-white/70">
          When a delivery problem shows up, it rarely lives in just one place. These are the five lenses Coherenz
          looks through together—not in isolation—to see where value is really being gained or lost.
        </p>
      </div>

      <p class="mt-[70px] text-center text-xs font-bold uppercase tracking-[0.375em] text-white/50">
        The Five Lenses of the Coherenz Diagnostic
      </p>
      <div class="dim-grid mt-6 flex flex-col gap-3 lg:flex-row lg:items-stretch lg:gap-0" data-reveal-grid>
        {systemDimensions.map((dim, i) => {
          const Icon = dimensionIcons[i];
          return (
            <Fragment>
              {i > 0 && (
                <div
                  class="hidden shrink-0 items-center justify-center px-4 text-white/30 lg:flex"
                  aria-hidden="true"
                  data-reveal-item
                  style={`transition-delay: ${i * 1500}ms`}
                >
                  →
                </div>
              )}
              <div
                class="dim-card flex flex-1 flex-col gap-3 border border-white/50 bg-navy/50 p-5"
                data-reveal-item
                style={`transition-delay: ${i * 1500}ms`}
              >
                <span class="flex h-10 w-10 items-center justify-center rounded-full border border-orange/40 text-orange">
                  <Icon size={20} stroke={1.8} />
                </span>
                <p class="text-xs font-bold uppercase tracking-wide text-orange">
                  {dim.number} — {dim.name}
                </p>
                <p class="text-sm text-white/70">{dim.question}</p>
              </div>
            </Fragment>
          );
        })}
      </div>

      <p class="float-up mt-[70px] max-w-2xl text-lg font-bold text-orange">
        Our work is about making those relationships visible—and helping leaders make better decisions because of
        them.
      </p>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <div class="hero-float-left">
        <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">The Shift</p>
        <h2 class="mt-3 max-w-2xl font-serif text-4xl text-navy sm:text-5xl">
          A different way of looking at product delivery.
        </h2>
      </div>

      <div class="mt-[50px]">
        <LinearCard client:visible items={shiftCardItems} />
      </div>
    </div>
  </section>

  <section class="bg-cream py-16 sm:py-24">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      {/* Fixed 420px first column (matching the portrait's own max-width)
          instead of an even 2-col split -- with an even split the gap value
          alone understates the real visual gap, since the image (capped at
          max-w-[420px]) sits left-justified inside a much wider column,
          leaving empty space before the gap even starts. Sizing the column
          to the image's actual rendered width makes the 100px gap the true
          on-screen distance between picture and text, without touching the
          image's own size or left-anchored position. */}
      <div class="grid grid-cols-1 items-center gap-[60px] lg:grid-cols-[420px_1fr] lg:gap-[100px]">
        <div class="hero-float-left flex justify-center lg:justify-start">
          <div class="relative w-full max-w-[420px]">
            {/* Warm orange radial backdrop, same character as the founder
                photo already used sitewide (FinalCta.astro's
                founder-cta-portrait.png) -- that portrait bakes its own
                gradient circle into the PNG, but this photo is a full
                transparent cutout, so the same treatment is applied here
                via CSS instead, for a consistent "Jon" visual across the
                site rather than a bare cutout floating on cream. */}
            <div
              class="pointer-events-none absolute left-1/2 top-1/2 -z-10 h-[425px] w-[425px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-gradient-to-br from-orange to-[#F0B457]"
              aria-hidden="true"
            />
            <img
              src={`${base}img/photography/about-founder-portrait.png`}
              alt="Jon Encarnacion, Founder & Principal, Coherenz, standing with arms crossed"
              class="relative w-full"
            />
          </div>
        </div>

        <div class="float-up">
          <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">Meet the Founder</p>
          <h2 class="mt-3 font-serif text-4xl text-navy sm:text-5xl">
            Built by a product and delivery leader who has worked inside the complexity.
          </h2>

          <p class="mt-4 text-foreground/70">
            Coherenz was founded by Jon Encarnacion, a product and delivery leader whose perspective has been shaped
            by working inside the kinds of complex organizations that Coherenz now helps leaders understand and
            improve.
          </p>
          <p class="mt-3 text-foreground/70">
            Over his career, Jon has worked across enterprise technology, telecommunications, energy, platforms,
            SaaS, and large-scale product and delivery environments. He has led teams and programs where the
            challenge was rarely a lack of intelligent people, commitment, or activity.
          </p>

          <p class="mt-5 font-semibold text-navy">The harder question was often:</p>
          <p class="mt-1 font-serif text-2xl text-navy">
            "With all this effort, are we actually creating the value we intended?"
          </p>

          <p class="mt-5 text-foreground/70">
            As organizations grow, delivery challenges often become harder to see clearly. Teams become specialized.
            Dependencies multiply. Priorities compete. More work enters the system than the organization can
            effectively absorb. Leaders may have extensive reporting and metrics while still struggling to
            understand where value is being delayed, diluted, or lost.
          </p>
          <p class="mt-3 text-foreground/70">That experience shaped the thinking behind Coherenz.</p>
          <p class="mt-3 text-foreground/70">
            Jon's work sits at the intersection of product strategy, delivery systems, organizational design, and
            economics. Rather than treating delivery as simply an execution function, he believes leaders need to
            understand how decisions about investment, priorities, capacity, flow, quality, and coordination
            interact to produce—or constrain—business outcomes.
          </p>
          <p class="mt-3 text-foreground/70">
            Coherenz is an extension of that belief: that better visibility into the system leads to better
            decisions, and better decisions create stronger outcomes.
          </p>

          <div class="mt-6">
            <div class="mx-auto mb-4 h-px w-16 bg-orange" aria-hidden="true" />
            <blockquote class="text-center font-serif text-xl italic text-navy">
              "I've spent much of my career working with organizations trying to move faster. Over time, I've
              learned that the better question is often not simply how do we move faster—but where is our effort
              actually creating value, and where is complexity quietly getting in the way?"
            </blockquote>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-wash-blue py-16 sm:py-24">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <div class="hero-float-left">
        <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">The Experience</p>
        <h2 class="mt-3 max-w-2xl font-serif text-4xl text-navy sm:text-5xl">
          Experience informs the perspective. Practice keeps it grounded.
        </h2>
        <p class="mt-4 max-w-2xl text-foreground/70">
          The ideas behind Coherenz were not developed in isolation. They have been shaped through years of working
          with product, technology, and business leaders across complex delivery environments.
        </p>
        <p class="mt-3 max-w-2xl text-foreground/70">
          These are the environments and challenges that have shaped the Coherenz perspective.
        </p>
      </div>

      <div class="exp-grid mt-[50px] grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {experienceAreas.map((area, i) => {
          const Icon = experienceIcons[i];
          return (
            <div class="exp-card flex flex-col gap-3 border border-line bg-white p-5" style={`transition-delay: ${i * 600}ms`}>
              <span class="flex h-10 w-10 items-center justify-center rounded-full border border-blue/30 bg-blue/10 text-blue">
                <Icon size={20} stroke={1.8} />
              </span>
              <p class="text-sm font-bold uppercase tracking-wide text-navy">{area.name}</p>
              <p class="text-sm text-foreground/70">{area.description}</p>
            </div>
          );
        })}
      </div>

      {/* Doc's "Optional CTA" for this section -- now a real link to
          /about/jon (same light-bg secondary-button variant as
          HeroDuplicate.astro). */}
      <div class="float-up mt-[50px] text-center">
        <a
          href={`${base}about/jon`}
          class="inline-block rounded-full border-2 border-orange px-6 py-3 text-sm font-bold text-orange transition-colors hover:bg-orange/10"
        >
          View Jon's Full Profile →
        </a>
      </div>
    </div>
  </section>

  <section class="bg-navy py-16 sm:py-24">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <div class="hero-float-left">
        <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">How We Work</p>
        <h2 class="mt-3 max-w-2xl font-serif text-4xl text-white sm:text-5xl">
          Practitioner experience. Structured thinking. Better decisions.
        </h2>
        <p class="mt-4 max-w-2xl text-white/70">
          Coherenz combines real-world practitioner experience with structured frameworks and modern methods to help
          leaders move from ambiguity to action. Our approach brings together:
        </p>
      </div>

      <div class="work-grid mt-[50px] flex flex-col gap-3 lg:flex-row lg:items-stretch lg:gap-0" data-reveal-grid>
        {howWeWork.map((item, i) => {
          const Icon = workIcons[i];
          return (
            <Fragment>
              {i > 0 && (
                <div
                  class="hidden shrink-0 items-center justify-center px-4 text-white/30 lg:flex"
                  aria-hidden="true"
                  data-reveal-item
                  style={`transition-delay: ${i * 1500}ms`}
                >
                  →
                </div>
              )}
              {/* Gradient-ring border, adapted from yield-card.tsx's
                  padding-wrapper pattern (its own background-clip:padding-box
                  version let the gradient bleed through the card's
                  translucent bg-white/5 interior instead of staying a thin
                  ring, so this uses the more reliable technique: the
                  gradient IS this wrapper's background, and `p-px` reveals
                  exactly 1px of it around an opaque inner card). Single-hue
                  orange, not the red/orange/yellow tri-color -- DESIGN.md §1
                  reserves that combination for the monogram only. */}
              <div
                class="flex flex-1 bg-gradient-to-br from-orange/0 via-orange/70 to-orange/0 p-px"
                data-reveal-item
                style={`transition-delay: ${i * 1500}ms`}
              >
                <div class="work-card flex flex-1 flex-col gap-3 bg-[#212e48] p-5">
                  <span class="flex h-10 w-10 items-center justify-center rounded-full border border-orange/40 text-orange">
                    <Icon size={20} stroke={1.8} />
                  </span>
                  <p class="text-xs font-bold uppercase tracking-wide text-orange">
                    {item.number} — {item.name}
                  </p>
                  <p class="text-sm text-white/70">{item.description}</p>
                </div>
              </div>
            </Fragment>
          );
        })}
      </div>
    </div>
  </section>

  <section class="bg-cream py-16 sm:py-24">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <div class="hero-float-left mx-auto max-w-2xl text-center">
        <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">The Coherenz Promise</p>
        <h2 class="mt-3 font-serif text-4xl text-navy sm:text-5xl">More clarity. Better decisions. Stronger outcomes.</h2>
        <p class="mt-4 text-foreground/70">
          The goal of Coherenz is not to add more process, meetings, reports, or frameworks to an already complex
          organization.
        </p>
        <p class="mt-3 font-semibold text-navy">The goal is to help leaders see more clearly:</p>
      </div>

      <div class="promise-grid mx-auto mt-[50px] flex max-w-2xl flex-col gap-3" data-reveal-grid>
        {promisePoints.map((point, i) => (
          <div
            class="promise-item flex items-start gap-3 border border-line bg-white p-4"
            data-reveal-item
            style={`--reveal-duration: 800ms; transition-delay: ${i * 500}ms`}
          >
            <IconCircleCheckFilled size={18} class="mt-0.5 shrink-0 text-green" />
            <p class="text-navy">{point}</p>
          </div>
        ))}
      </div>

      <p class="float-up mx-auto mt-[50px] max-w-2xl text-center text-foreground/70">
        Because when leaders can see the system more clearly, they can make better choices about where to invest,
        what to prioritize, and how to organize for the outcomes that matter.
      </p>
    </div>
  </section>

  <div class="relative overflow-hidden bg-navy">
    <img
      src={`${base}img/monogram.svg`}
      alt=""
      class="pointer-events-none absolute -right-6 -top-20 w-96 opacity-[0.22] sm:-right-4 sm:w-[30rem]"
    />
    <FinalCta
      showPortrait={false}
      showMonogram={false}
      transparent
      eyebrow="Ready to Look Differently?"
      body="Start with the questions that reveal where complexity, capacity, and value may be misaligned."
      ctaText="Explore the Coherenz Diagnostic →"
      ctaHref={`${base}programs/product-delivery-economics-assessment`}
      secondaryCtaText="Start a Conversation →"
      secondaryCtaHref={`${base}contact`}
    >
      <Fragment slot="headline">Ready to look at your delivery system differently?</Fragment>
    </FinalCta>
    <Footer transparent />
  </div>
</Layout>

<script>
  // Same off-screen pause pattern as the other hero videos on this site --
  // a looping autoplay video keeps decoding/buffering frames indefinitely
  // even while scrolled far out of view.
  function initAboutHeroVideoPause() {
    const section = document.getElementById('about-hero');
    const video = document.getElementById('about-hero-video') as HTMLVideoElement | null;
    if (!section || !video) return;

    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) video.play().catch(() => {});
        else video.pause();
      },
      { threshold: 0 }
    );
    io.observe(section);
  }

  initAboutHeroVideoPause();
  document.addEventListener('astro:page-load', initAboutHeroVideoPause);
</script>

<style>
  /* Float-in from the left, same character as every other page hero:
     28px travel, 1500ms, strong ease-out. Fires immediately since this
     hero is always in the first viewport on load. */
  .hero-float-left {
    opacity: 0;
    transform: translateX(-28px);
    transition:
      opacity 1500ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 1500ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .hero-float-left.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-float-left {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initHeroFloatLeft() {
    document.querySelectorAll<HTMLElement>('.hero-float-left').forEach((el) => {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          el.classList.add('is-visible');
          io.disconnect();
        },
        { threshold: 0.2 }
      );
      io.observe(el);
    });
  }

  initHeroFloatLeft();
  document.addEventListener('astro:page-load', initHeroFloatLeft);
</script>

<style>
  /* Float-in from the bottom, same character used across the site
     (CoherenzPerspective.astro, ActionAndClosing.astro, approach.astro's
     #bridge): 28px travel, 1500ms, strong ease-out. */
  .float-up {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 1500ms cubic-bezier(0.23, 1, 0.32, 1),
