---
// Ported from the vanilla approach.html — same real copy, same section
// order. PDE-OS section and closing CTA reuse the homepage's PdeosWheel and
// FinalCta components directly rather than rebuilding a second version of
// the same wheel/CTA, per the project's "reuse components" convention.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FinalCta from '../components/FinalCta.astro';
import PdeosWheel from '../components/PdeosWheel.tsx';
import ThreeQuestions from '../components/ThreeQuestions.astro';
import ResourceBento from '../components/ui/resource-bento.tsx';
import PhasesWheel from '../components/ui/phases-wheel.tsx';
import { base } from '../lib/base';
---

<Layout
  title="The Coherenz Approach — Product Delivery Economics™"
  description="Product delivery is an economic system. Every organization has limited money, people, capacity, time and attention — the Coherenz approach treats every product decision as an investment decision."
>
  <Nav />

  <section id="approach-hero" class="relative flex min-h-[70vh] items-end overflow-hidden bg-navy">
    <video
      id="approach-hero-video"
      class="absolute inset-0 h-full w-full object-cover"
      autoplay
      muted
      loop
      playsinline
    >
      <source src={`${base}video/services-hero.mp4`} type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-gradient-to-t from-navy via-navy/70 to-navy/20" />
    <div class="relative mx-auto w-full max-w-[1536px] px-6 py-20 sm:px-8 lg:px-10 xl:px-14">
      <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">The Coherenz Approach</p>
      <h1 class="mt-3 max-w-2xl font-serif text-4xl text-white sm:text-5xl">
        Product delivery is an economic system.
      </h1>
      <p class="mt-4 max-w-2xl text-white/80">
        Every organization has limited money, people, capacity, time, and attention. Therefore every
        product decision is ultimately an investment decision.
      </p>
    </div>
  </section>

  <section id="core-idea" class="bg-white pt-16 pb-[100px] sm:pt-24">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">The Core Idea</p>
      <h2 class="mt-3 max-w-2xl font-serif text-4xl text-navy sm:text-5xl">
        Every organization operates with finite resources.
      </h2>
      <div class="mt-[100px]">
        <ResourceBento client:visible />
      </div>
      <p class="mx-auto mt-10 max-w-2xl text-center text-[20px] font-semibold text-navy">
        Every decision competes for a share of them.
      </p>
      <p class="mx-auto mt-2 max-w-2xl text-center text-[20px] font-semibold text-navy">
        Therefore, every product decision is ultimately an investment decision.
      </p>
    </div>
  </section>

  <!-- Narrative bridge (Change Brief §3) -- the only new content block on
       the page, deliberately lightweight: a narrow centered statement
       rather than a full section, so the WHAT/HOW/DID framework right
       after it reads as the direct answer to "these decisions are often
       made separately" rather than a new, unrelated topic. -->
  <section id="bridge" class="relative overflow-hidden bg-navy py-[70px] sm:py-[100px]">
    <video id="bridge-video" class="absolute inset-0 h-full w-full object-cover" autoplay muted loop playsinline>
      <source src={`${base}video/approach-bridge-bg.mp4`} type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-navy/70" />
    <div class="relative mx-auto max-w-2xl px-6 text-center sm:px-8">
      <div class="mx-auto mb-8 h-px w-16 bg-orange" aria-hidden="true" />
      <p class="font-serif text-[28px] text-white sm:text-[34px]">
        The challenge is that these decisions are often made separately.
      </p>
      <p class="mt-4 text-white/70">
        Product teams decide what to pursue. Delivery teams focus on execution. Leaders measure results later.
        But the connection between investment, delivery, and outcomes is not always visible.
      </p>
      <p class="mt-6 text-lg font-bold text-orange">Coherenz connects the decisions across the system.</p>
    </div>
  </section>

  <ThreeQuestions />

  <PdeosWheel
    client:visible
    eyebrow="Product Delivery Economics™"
    headline="From connected decisions to continuous learning."
    body="PDE-OS™ is how we connect investment, delivery, and outcomes throughout the product delivery lifecycle."
    showCta={false}
  />

  <section id="phases" class="bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-[1536px] px-6 sm:px-8 lg:px-10 xl:px-14">
      <p class="text-sm font-bold uppercase tracking-[0.375em] text-orange">The Operating Model</p>
      <h2 class="mt-3 max-w-2xl font-serif text-4xl text-navy sm:text-5xl">PDE-OS in Practice</h2>
      <p class="mt-4 max-w-2xl text-foreground/70">
        PDE-OS is a loop, not a line — Learn feeds straight back into Discover. Expand any phase below
        to see its purpose, the question it answers, and what it hands off.
      </p>
      <div class="mt-10">
        <PhasesWheel client:visible />
      </div>
    </div>
  </section>

  <div class="relative overflow-hidden bg-navy">
    <img
      src={`${base}img/monogram.svg`}
      alt=""
      class="pointer-events-none absolute -right-6 -top-20 w-96 opacity-[0.22] sm:-right-4 sm:w-[30rem]"
    />
    <FinalCta
      showPortrait={false}
      showMonogram={false}
      transparent
      eyebrow="What Happens Next"
      body="Whether the challenge is choosing what to invest in, improving delivery performance, or understanding where capacity is being lost, Coherenz helps connect the decisions that shape outcomes."
      ctaText="Explore Our Services →"
      ctaHref={`${base}services`}
      secondaryCtaText="Talk to Coherenz →"
      secondaryCtaHref={`${base}contact`}
    >
      <Fragment slot="headline">See where better decisions could create greater value.</Fragment>
    </FinalCta>
    <Footer transparent />
  </div>
</Layout>

<script>
  // Same off-screen pause pattern as HeroDuplicate's video -- a looping
  // autoplay video keeps decoding/buffering frames indefinitely even while
  // scrolled far out of view. Shared by both background videos on this page
  // (the hero and the narrative-bridge section).
  function pauseVideoWhenOffscreen(sectionId: string, videoId: string) {
    const section = document.getElementById(sectionId);
    const video = document.getElementById(videoId) as HTMLVideoElement | null;
    if (!section || !video) return;

    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) video.play().catch(() => {});
        else video.pause();
      },
      { threshold: 0 }
    );
    io.observe(section);
  }

  function initApproachVideoPause() {
    pauseVideoWhenOffscreen('approach-hero', 'approach-hero-video');
    pauseVideoWhenOffscreen('bridge', 'bridge-video');
  }

  initApproachVideoPause();
  document.addEventListener('astro:page-load', initApproachVideoPause);
</script>
